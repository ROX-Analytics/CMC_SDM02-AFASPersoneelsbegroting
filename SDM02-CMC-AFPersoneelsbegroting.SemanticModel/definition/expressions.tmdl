expression 'Dim Vacature per Verschil FTE' = ```
		let
		    Source = #"Buffered Dim Vacatures Medewerker (STG)",
		    #"Removed Other Columns" = Table.SelectColumns(Source,{"Formatieplaats", "Omschrijving", "Verschil (excl)"}),
		    
		    // ExpandedRows
		    ExpandedRows = Table.AddColumn(#"Removed Other Columns", "Generated Rows", each
		        let 
		            verschil = [#"Verschil (excl)"],
		            formatieplaats = [#"Formatieplaats"],
		            count = Number.IntegerDivide(verschil, 1),
		            remainder = Number.Mod(verschil, 1),
		            baseList = List.Repeat({1}, count),
		            finalList = if remainder > 0 then baseList & {remainder} else baseList,
		            newRows = List.Transform(finalList, each [#"Formatieplaats" = formatieplaats, #"Verschil (excl)" = _])
		        in 
		            newRows
		    ),
		    #"Removed Other Columns1" = Table.SelectColumns(ExpandedRows,{"Generated Rows"}),
		    #"Expanded Generated Rows" = Table.ExpandListColumn(#"Removed Other Columns1", "Generated Rows"),
		    Result = Table.ExpandRecordColumn(#"Expanded Generated Rows", "Generated Rows", {"Formatieplaats", "Verschil (excl)"}),
		    #"Changed Type" = Table.TransformColumnTypes(Result,{{"Formatieplaats", type text}, {"Verschil (excl)", type number}}),
		    #"Added Index" = Table.AddIndexColumn(#"Changed Type", "Index", 1, 1, Int64.Type),
