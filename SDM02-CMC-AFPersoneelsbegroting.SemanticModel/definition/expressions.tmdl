		(year as number) as table =>
		let
		    // Define start and end of forecasting year
		    StartDate = #date(year + 1, 1, 1),
		    EndDate = #date(year + 1, 12, 31),
		
		    // Generate all dates within the forecast year
		    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
		
		    // Add calendar columns
		    AddColumns = Table.AddColumn(
		        Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
		        "Year", each Date.Year([Date]), type number
		    ),
		    AddMonth = Table.AddColumn(AddColumns, "Month", each Date.Month([Date]), type number),
		    AddPeriod = Table.AddColumn(AddMonth, "Period", each Date.Month([Date]), type number),
		    AddQuarter = Table.AddColumn(AddPeriod, "Quarter", each Date.QuarterOfYear([Date]), type number)
		
		    
		in
		    AddQuarter
		```
