expression 'Forecasting Medewerker Date Function Test' =
		(year as number) as table =>
		let
		    // Define start and end of forecasting year
		    StartDate = #date(year, 1, 1),
		    EndDate = #date(year, 12, 31),
		
		    // Generate all dates within the forecast year
		    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
		
		    // Create initial table from list of dates
		    BaseTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
		
		    // Add calendar columns
		    AddColumns = Table.AddColumn(BaseTable, "Year", each Date.Year([Date]), type number),
		    AddMonth = Table.AddColumn(AddColumns, "Month", each Date.Month([Date]), type number),
		    AddQuarter = Table.AddColumn(AddMonth, "Quarter", each Date.QuarterOfYear([Date]), type number),
		
		    // Group by Year + Month (as Period)
		    Grouped = Table.Group(
		        AddQuarter,
		        {"Year", "Month"},
		        {
		            {"StartDate", each List.Min([Date]), type date},
		            {"EndDate", each List.Max([Date]), type date},
		            {"Quarter", each List.First([Quarter]), type number}
		        }
		    ),
		
		    // Rename Month -> Period
		    Renamed = Table.RenameColumns(Grouped, {{"Month", "Period"}})
		in
		    Renamed
