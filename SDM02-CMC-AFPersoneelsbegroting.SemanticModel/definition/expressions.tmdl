	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Extrapolatie Salarissen for Schemawerk' =
		// Extrapolate latest period of latest year to period 12
		(inputTable as table) as table =>
		let
		    // Use "Periode" if present, else fall back to "Boekingsperiode"
		    PeriodCol = if List.Contains(Table.ColumnNames(inputTable), "Periode")
		                then "Periode" else "Boekingsperiode",
		
		    LatestYear   = List.Max(Table.Column(inputTable, "Jaar")),
		    LatestYearTb = Table.SelectRows(inputTable, each Record.Field(_, "Jaar") = LatestYear),
		
		    LatestPeriod = List.Max(Table.Column(LatestYearTb, PeriodCol)),
		    PeriodsToAdd = if LatestPeriod < 12 then {LatestPeriod + 1 .. 12} else {},
		
		    // Source rows to copy (the latest actual period of the latest year)
		    BaseRows = Table.SelectRows(LatestYearTb, each Record.Field(_, PeriodCol) = LatestPeriod),
		
		    // Build extrapolated rows by just replacing the period value
		    ExtrapolatedRows =
		        if List.Count(PeriodsToAdd) = 0 then
		            #table(Table.ColumnNames(inputTable), {})
		        else
		            Table.Combine(
		                List.Transform(
		                    PeriodsToAdd,
		                    (p) => Table.TransformColumns(BaseRows, {{PeriodCol, (x) => p, Int64.Type}})
		                )
		            ),
		
		    // Tag rows
		    ActualsTagged = Table.AddColumn(inputTable, "IsExtrapolated", each false, type logical),
		    ExtrasTagged  =
		        if Table.IsEmpty(ExtrapolatedRows) then
		            ExtrapolatedRows
		        else
		            Table.AddColumn(ExtrapolatedRows, "IsExtrapolated", each true, type logical),
		
		    Result = Table.Combine({ActualsTagged, ExtrasTagged})
		in
		    Result
	lineageTag: 6aa1033b-fd41-434e-b0d4-9eba6bf5166f
	queryGroup: 'Functions Forecasting'

