expression 'Extrapolatie Salaris Indexering Actuals' =
		(inputTable as table) as table =>
		let
		    CurrentYear = Date.Year(DateTime.LocalNow()),
		
		    // Ensure the required columns exist
		    RequiredColumns = {"Jaar", "Boekingsperiode"},
		    AllColumnsPresent = List.MatchesAll(RequiredColumns, (col) => List.Contains(Table.ColumnNames(inputTable), col)),
		
		    Output =
		        if AllColumnsPresent then
		            let
		                // Step 1: Filter to current year
		                CurrentYearData = Table.SelectRows(inputTable, each [Jaar] = CurrentYear),
		
		                // Step 2: Find latest actual period
		                PeriodsAvailable = List.Distinct(CurrentYearData[Boekingsperiode]),
		                MaxAvailablePeriod = if List.Count(PeriodsAvailable) > 0 then List.Max(PeriodsAvailable) else null,
		
		                // Step 3: Determine future periods to extrapolate
		                PeriodsToExtrapolate = if MaxAvailablePeriod <> null and MaxAvailablePeriod < 12 then
		                    List.Select({1..12}, each _ > MaxAvailablePeriod)
		                else
		                    {},
		
		                // Step 4: Select rows to replicate from the latest period
		                SourceForExtrapolation = if MaxAvailablePeriod <> null and MaxAvailablePeriod < 12 then
		                    Table.SelectRows(CurrentYearData, each [Boekingsperiode] = MaxAvailablePeriod)
		                else
		                    #table(Table.ColumnNames(inputTable), {}),  // empty table with correct schema
		
		                // Step 5: Create extrapolated rows with updated Boekingsperiode
		                RepeatedRows = List.Transform(PeriodsToExtrapolate, (newPeriod) =>
		                    Table.TransformColumns(
		                        Table.DuplicateColumn(SourceForExtrapolation, "Boekingsperiode", "OriginalBoekingsperiode"),
		                        {{"Boekingsperiode", each newPeriod, type number}}
		                    )
		                ),
		                CombinedExtrapolated = if List.Count(RepeatedRows) > 0 then Table.Combine(RepeatedRows) else SourceForExtrapolation,
		
		                // Step 6: Add IsExtrapolated flag
		                WithExtrapolatedFlag = Table.AddColumn(CombinedExtrapolated, "IsExtrapolated", each true),
		                WithActualsFlag = Table.AddColumn(CurrentYearData, "IsExtrapolated", each false),
		
		                // Step 7: Combine and return
		                Final = Table.Combine({WithActualsFlag, WithExtrapolatedFlag})
		            in
		                Final
		        else
		            Table.SelectRows(inputTable, each false) // Fallback: return empty table if Jaar or Boekingsperiode missing
		in
		    Output
	lineageTag: c0522d5b-798b-42a5-8a44-07defa578253
	queryGroup: 'Functions Forecasting'

