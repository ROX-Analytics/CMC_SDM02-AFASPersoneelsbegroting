	queryGroup: 'Functions Forecasting'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression 'Extrapolatie Salaris Indexering Actuals' =
		(inputTable as table) as table =>
		let
		    CurrentYear = Date.Year(DateTime.LocalNow()),
		    RequiredColumns = {"Jaar","Boekingsperiode","Medewerker ID"},
		    AllColumnsPresent = List.MatchesAll(RequiredColumns, (c) => List.Contains(Table.ColumnNames(inputTable), c)),
		
		    Output =
		    if AllColumnsPresent then
		        let
		            // 1) Current year only
		            CurrentYearData = Table.SelectRows(inputTable, each [Jaar] = CurrentYear),
		
		            // 2) Flag actuals
		            WithActualsFlag = Table.AddColumn(CurrentYearData, "IsExtrapolated", each false, type logical),
		
		            // 3) Group per medewerker, keep only rows from their max Boekingsperiode
		            LastRowPerMedewerker =
		                Table.Group(
		                    WithActualsFlag,
		                    {"Medewerker ID"},
		                    {
		                        {"LastRows",
		                            (t as table) =>
		                                let
		                                    maxP = List.Max(t[Boekingsperiode]),
		                                    rows = Table.SelectRows(t, each [Boekingsperiode] = maxP)
		                                in rows,
		                            type table
		                        }
		                    }
		                ),
		
		            // 4) Expand inner table, but EXCLUDE the grouping key to avoid duplicates
		            ColumnsToExpand = List.RemoveItems(Table.ColumnNames(WithActualsFlag), {"Medewerker ID"}),
		            Expanded = Table.ExpandTableColumn(LastRowPerMedewerker, "LastRows", ColumnsToExpand),
		
		            // 5) Build list of future periods for each medewerker
		            WithPeriods =
		                Table.AddColumn(
		                    Expanded, "NewPeriod",
		                    each if [Boekingsperiode] < 12 then {[Boekingsperiode]+1 .. 12} else {},
		                    type list
		                ),
		
		            // 6) One row per future period
		            Replicated = Table.ExpandListColumn(WithPeriods, "NewPeriod"),
		
		            // 7) Keep original period and swap in the new one
		            WithOriginal = Table.DuplicateColumn(Replicated, "Boekingsperiode", "OriginalBoekingsperiode"),
		            AddedNewBP  = Table.AddColumn(WithOriginal, "Boekingsperiode New", each [NewPeriod], Int64.Type),
		            RemovedHelp = Table.RemoveColumns(AddedNewBP, {"NewPeriod","Boekingsperiode"}),
		            RenamedBP   = Table.RenameColumns(RemovedHelp, {{"Boekingsperiode New","Boekingsperiode"}}),
		
		            // 8) Mark extrapolated
		            MarkExtrapolated = Table.ReplaceValue(RenamedBP, false, true, Replacer.ReplaceValue, {"IsExtrapolated"}),
		
		            // 9) Combine actuals + extrapolated
		            Final = Table.Combine({WithActualsFlag, MarkExtrapolated})
		        in
		            Final
		    else
		        Table.SelectRows(inputTable, each false)
		in
		    Output
	lineageTag: c0522d5b-798b-42a5-8a44-07defa578253
	queryGroup: 'Functions Forecasting'

