expression 'Fact Forecasting Medewerkers Source' = ```
		let
		    // Employees
		    Employees = Table.SelectColumns(#"Dim Medewerker", {"Medewerker ID", "Aantal_FTE", "Flag Medewerker"}),
		
		    #"Filtered Rows" = Table.SelectRows(Employees, each ([Flag Medewerker] = 1)),
		    #"Removed Duplicates" = Table.Distinct(#"Filtered Rows", {"Medewerker ID"}),
		    RenamedEmployees = Table.RenameColumns(#"Removed Duplicates", {{"Aantal_FTE", "FTE"}}),
		
		    // LC table (buffer since it's reused)
		    DimLCperGB = Table.Buffer(#"Dim LC per GL Support"),
		
		    // 🔹 Cross join Employees × LC (done in one step)
		    WithLC = Table.AddColumn(RenamedEmployees, "DimLCperGB", each DimLCperGB),
		    ExpandedLC = Table.ExpandTableColumn(
		        WithLC,
		        "DimLCperGB",
		        {"LC", "Omschrijving LC", "Grootboekrekening", "Grootboekrekening_omschrijving"}
		    ),
		
		    // 🔹 Add forecasting year
		    AddYear = Table.AddColumn(ExpandedLC, "Year Forecasting", each Date.Year(DateTime.LocalNow()) + 1, Int64.Type),
		
		    // 🔹 Generate 12 periods as list
		    AddPeriods = Table.AddColumn(AddYear, "Period", each List.Transform({1..12}, each Text.PadStart(Text.From(_),2,"0"))),
		    ExpandedPeriods = Table.ExpandListColumn(AddPeriods, "Period"),
		    #"Added Custom" = Table.AddColumn(ExpandedPeriods, "Period (leading zeros)", each [Period], type nullable text),
		    ChangedType = Table.TransformColumnTypes(#"Added Custom", {{"Period", Int64.Type}}),
		
		    DimMedwerker = Table.Buffer(#"Dim Medewerker"),
		
		    #"Merged Queries1" = Table.NestedJoin(ChangedType, {"Medewerker ID"}, DimMedwerker, {"Medewerker ID"}, "Dim Medewerker Details", JoinKind.LeftOuter),
		    #"Expanded Dim Medewerker Details" = Table.ExpandTableColumn(#"Merged Queries1", "Dim Medewerker Details", {"Anniversary Month", "Kostenplaats", "Naam_werkgever", "Schaal ID", "Type Personeel ID", "Type Zorg Functie"}, {"Anniversary Month", "Kostenplaats", "Naam_werkgever", "Schaal ID", "Type Personeel ID", "Type Zorg Functie"}),
		    #"Added Custom year/period" = Table.AddColumn(#"Expanded Dim Medewerker Details", "Year/Period", each Text.From([Year Forecasting]) & "/" & Text.From([#"Period (leading zeros)"]), type nullable text),
		
		    FactMaxSal = Table.Buffer(#"Fact Medewerker MAX Salaris Incl Indexering"),
		    FactMaxSchaal = Table.Buffer(#"Fact Medewerker MAX Schaal/Trede Actuals"),
		    DimSchaal = Table.Buffer(#"Dim SchaalType"),
		    FactAfbouwSal = Table.Buffer(#"Fact Afbouw Salarissen 2026_2027_2028"),
		    FactSoftlanding = Table.Buffer(#"Fact Afbouw Softlanding 2026_2027_2028"),
		
		    #"Merged Queries2" = Table.NestedJoin(#"Added Custom year/period", {"Medewerker ID"}, FactMaxSal, {"Medewerker ID"}, "Fact Medewerker MAX Salaris Incl Indexering", JoinKind.LeftOuter),
		    #"Expanded Fact Medewerker MAX Salaris Incl Indexering" = Table.ExpandTableColumn(#"Merged Queries2", "Fact Medewerker MAX Salaris Incl Indexering", {"Index Name Actuals", "Max Salaris End Actuals"}, {"Index Name Actuals", "Max Salaris End Actuals"}),
		    #"Filtered Rows1" = Table.SelectRows(#"Expanded Fact Medewerker MAX Salaris Incl Indexering", each ([Max Salaris End Actuals] <> null)),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Filtered Rows1",{{"Index Name Actuals", type text}}),
		    #"Merged Queries3" = Table.NestedJoin(#"Changed Type1", {"Medewerker ID"}, FactMaxSchaal, {"Medewerker ID"}, "Fact Medewerker MAX Schaal/Trede Actuals", JoinKind.LeftOuter),
		    #"Expanded Fact Medewerker MAX Schaal/Trede Actuals" = Table.ExpandTableColumn(#"Merged Queries3", "Fact Medewerker MAX Schaal/Trede Actuals", {"New Schaal ID (Trede Verhoging Actuals)", "MAX Trede Actuals"}, {"New Schaal ID (Trede Verhoging Actuals)", "MAX Trede Actuals"}),
		    #"Merged Queries4" = Table.NestedJoin(#"Expanded Fact Medewerker MAX Schaal/Trede Actuals", {"New Schaal ID (Trede Verhoging Actuals)"}, DimSchaal, {"Schaal ID"}, "Dim SchaalType", JoinKind.Inner),
		    #"Expanded Dim SchaalType" = Table.ExpandTableColumn(#"Merged Queries4", "Dim SchaalType", {"SchaalType Forecasting"}, {"SchaalType Forecasting"}),
		    #"Added Custom3" = Table.AddColumn(#"Expanded Dim SchaalType", "Trede Verhoging (Forecasting)", each if ([Anniversary Month] = [Period] or [Period] > [Anniversary Month]) and [Type Zorg Functie] <> "Arts-assistenten" and [SchaalType Forecasting] <> "Andere OVK" and [MAX Trede Actuals] = false then true else false, type logical),
		    #"Added Custom4" = Table.AddColumn(#"Added Custom3", "New Schaal ID (Forecasting)", each if [#"Trede Verhoging (Forecasting)"] = true then ([#"New Schaal ID (Trede Verhoging Actuals)"] + 1) else [#"New Schaal ID (Trede Verhoging Actuals)"], type nullable number),
		    #"Merged Queries5" = Table.NestedJoin(#"Added Custom4", {"New Schaal ID (Forecasting)"}, DimSchaal, {"Schaal ID"}, "Dim SchaalType", JoinKind.LeftOuter),
		    #"Expanded Dim SchaalType1" = Table.ExpandTableColumn(#"Merged Queries5", "Dim SchaalType", {"Salaris"}, {"Salaris"}),
		    #"Changed Type4" = Table.TransformColumnTypes(#"Expanded Dim SchaalType1",{{"Salaris", type number}}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type4",{{"Salaris", "Salaris New Forecasting"}}),
		    #"Added Custom5" = Table.AddColumn(#"Renamed Columns1", "Salaris Base Forecasting", each if [#"Trede Verhoging (Forecasting)"] = true  then [Salaris New Forecasting] else [Max Salaris End Actuals], type nullable number),
		    #"Conditional Merge" = 
		        let 
		            IsEmptyCondition = Table.IsEmpty(FactAfbouwSal),
		            JointableRaw = FactAfbouwSal,
		            JoinColumnsLeft = {"Medewerker ID", "Year Forecasting"},
		            JoinColumnsRght = {"Mdw.", "Jaar"},
		            ExpandColumns = {"Salaris per Mnd"},
		            JoinColumnName = "Fact Afbouw Salarissen 2026_2027_2028",
		            BaseTable = #"Added Custom5",
		
		            SafeJoinTable =
		                let 
		                    ExpectedSchema = JoinColumnsRght & ExpandColumns,
		                    SafeTable = 
		                        if IsEmptyCondition then #table(ExpectedSchema, {}) else JointableRaw
		                in 
		                    SafeTable,
		
		            Merge = Table.NestedJoin(
		                    BaseTable, 
		                    {"Medewerker ID", "Year Forecasting"},
		                    SafeJoinTable,
		                    {"Mdw.", "Jaar"},
		                    JoinColumnName,
		                    JoinKind.LeftOuter),
		            
		            ExpandedColumn = Table.ExpandTableColumn(Merge, JoinColumnName, ExpandColumns)
		
		        in 
		            ExpandedColumn,
		    #"Changed Type6" = Table.TransformColumnTypes(#"Conditional Merge",{{"Salaris per Mnd", type number}}),
		    #"Renamed Columns2" = Table.RenameColumns(#"Changed Type6",{{"Salaris Base Forecasting", "Salaris Base Forecasting Original"}}),
		    #"Added Custom6" = Table.AddColumn(#"Renamed Columns2", "Salaris Base Forecasting", each if [Salaris per Mnd] <> null then [Salaris per Mnd] else [Salaris Base Forecasting Original], type nullable number),
		    #"Conditional Merge Softlanding" = 
		        let 
		            IsEmptyCondition = Table.IsEmpty(FactSoftlanding),
		            JoinTableRaw = FactSoftlanding,
		            JoinColumnsLeft = {"Medewerker ID", "Year Forecasting", "LC"},
		            JoinColumnsRght = {"Mdw.", "Jaar", "LC"},
		            ExpandColumns = {"Softlanding per Maand"},
		            JoinColumnName = "Fact Afbouw Softlanding 2026_2027_2028",
		            BaseTable = #"Added Custom6",
		
		            SafeJoinTable =
		                let 
		                    ExpectedSchema = JoinColumnsRght & ExpandColumns,
		                    SafeTable = 
		                        if IsEmptyCondition then #table(ExpectedSchema, {}) else JoinTableRaw
		                in 
		                    SafeTable,
		            
		            Merge = Table.NestedJoin(
		                BaseTable,
		                {"Medewerker ID", "Year Forecasting", "LC"},
		                SafeJoinTable,
		                {"Mdw.", "Jaar", "LC"},
		                "Fact Afbouw Softlanding 2026_2027_2028",
		                JoinKind.LeftOuter
		                ),
		            
		            ExpandedColumn = Table.ExpandTableColumn(Merge, JoinColumnName, ExpandColumns)
		        in 
		            ExpandedColumn
		in
		    #"Conditional Merge Softlanding"
		```
