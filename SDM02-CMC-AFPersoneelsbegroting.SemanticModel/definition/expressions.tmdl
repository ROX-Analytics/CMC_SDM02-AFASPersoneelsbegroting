	annotation PBI_ResultType = Table

expression 'Extrapolatie Salarissen for Schemawerk Test' =
		(inputTable as table) as table =>
		let
		    // Determine period column
		    PeriodCol = if Record.HasFields(Table.Schema(inputTable){0}, "Periode") then "Periode" else "Boekingsperiode",
		
		    // Extract latest year and filter table
		    LatestYear = List.Max(inputTable[Jaar]),
		    LatestYearTb = Table.SelectRows(inputTable, each [Jaar] = LatestYear),
		
		    // Get latest period and determine extrapolation range
		    LatestPeriod = List.Max(LatestYearTb[PeriodCol]),
		    PeriodsToAdd = List.Range({LatestPeriod + 1 .. 12}, 0, 12 - LatestPeriod),
		
		    // Base rows to replicate
		    BaseRows = Table.SelectRows(LatestYearTb, each Record.Field(_, PeriodCol) = LatestPeriod),
		
		    // Generate extrapolated rows
		    ExtrapolatedRows =
		        List.Transform(PeriodsToAdd, (p) =>
		            Table.TransformRows(BaseRows, each Record.TransformFields(_, {{PeriodCol, (_) => p, Int64.Type}}))
		        ),
		    CombinedExtras = if List.Count(ExtrapolatedRows) > 0 then Table.Combine(ExtrapolatedRows) else #table(Table.ColumnNames(inputTable), {}),
		
		    // Tag actuals and extrapolated
		    ActualsTagged = Table.AddColumn(inputTable, "IsExtrapolated", each false, type logical),
		    ExtrasTagged = Table.AddColumn(CombinedExtras, "IsExtrapolated", each true, type logical),
		
		    // Final result
		    Result = Table.Combine({ActualsTagged, ExtrasTagged})
		in
		    Result
	lineageTag: d46ea4ca-6d75-4b10-ae34-f3328631e772
	queryGroup: 'Functions Forecasting'

