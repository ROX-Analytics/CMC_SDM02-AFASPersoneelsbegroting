		    #"Add ID" = Table.AddColumn(#"Tranform MdW ID", "Formatieplaats Verschil ID", each Text.From([Formatieplaats]) & "_" & Text.From([#"Medewerker ID"]), type nullable text),
		    #"Sorted Rows" = Table.Sort(#"Add ID",{{"Formatieplaats", Order.Ascending}}),
		    #"Added Index1" = Table.AddIndexColumn(#"Sorted Rows", "Index for Merge", 1, 1, Int64.Type),
		    #"Merged Queries" = Table.NestedJoin(#"Added Index1", {"Formatieplaats", "Index for Merge"}, #"Dim Vacature Conditional Index", {"Formatieplaats", "Index for Merge"}, "Dim Vacature Conditional Index", JoinKind.LeftOuter),
		    #"Expanded Dim Vacature Conditional Index" = Table.ExpandTableColumn(#"Merged Queries", "Dim Vacature Conditional Index", {"Index.Index"}, {"Index.Index"}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Expanded Dim Vacature Conditional Index",{{"Index.Index", "Nr van Vacature"}})
		in
		    #"Renamed Columns1"
		```
