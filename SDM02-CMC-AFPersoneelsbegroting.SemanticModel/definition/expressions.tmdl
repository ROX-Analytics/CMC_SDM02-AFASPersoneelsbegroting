	annotation PBI_ResultType = Function

expression Query1 = ```
		()=>
		let
		    // ──────────────────── 1. CONFIG ────────────────────
		    Token       = "AfasToken PHRva2VuPjx2ZXJzaW9uPjE8L3ZlcnNpb24+PGRhdGE+Qjk5N0I1MjNGMzhENDgwNjgyRTA0NzQ4RkZCQUQ1RjU5MTA1OEU3QUEwQTQ0MDMxODlBNUVGNTNEMjFDREQ5MTwvZGF0YT48L3Rva2VuPg==",            //  ◄─ replace with your real bearer token
		    BaseUrl     = "https://86331.rest.afas.online/ProfitRestServices/connectors/CMC_Financiele_mutaties_QDO",
		
		    Years       = List.Transform({2025..2025}, each Text.From(_)),   // 2025 and onward
		    Periods     = List.Transform({1..12},    each Text.From(_)),     // periods 1-12
		
		    // ──────────────────── 2. HELPER ────────────────────
		    GetRows = (yr as text, prd as text) as table =>
		        let
		            // Build a query string with duplicated keys (Power Query records can't hold dups)
		            QueryString = 
		                "filterfieldids=Jaar" &                       // field 1
		                "&filtervalues="   & yr &                     // value 1
		                "&operatortypes=1" &                         
		                "&filterfieldids=Periode" &                   // field 2
		                "&filtervalues="   & prd &                    // value 2
		                "&operatortypes=1" &
		                "&skip=-1&take=-1",
		
		            Source      = Web.Contents(
		                             BaseUrl,
		                             [
		                                 Headers = [
		                                     Authorization = Token,
		                                     #"Content-Type" = "application/json"
		                                 ],
		                                 RelativePath = "?" & QueryString
		                             ]
		                         ),
		            Json        = Json.Document(Source),
		            RowsList    = Json[rows],                          // list of records (or null)
		            DataTable   = if List.IsEmpty(RowsList) then null
		                          else
		                              let
		                                  T0 = Table.FromRecords(RowsList),
		                                  T1 = Table.AddColumn(T0, "Jaar",    each yr,  type text),
		                                  T2 = Table.AddColumn(T1, "Periode", each prd, type text)
		                              in
		                                  T2
		        in
		            DataTable,
		
		    // ──────────────────── 3. RUN ALL YEAR-PERIOD CALLS ────────────────────
		    Tables =
		        List.Transform(
		            Years,
		            (y) => List.Transform(Periods, each GetRows(y, _))
		        ),
		        // > List.Combine        // flatten the nested list
		        // > List.RemoveNulls,   // drop periods with no rows
		
		    // ──────────────────── 4. COMBINE ────────────────────
		    Final =
		        if List.Count(Tables) = 0
		        then #table({}, {})         // empty table if nothing came back
		        else Table.Combine(Tables)
		in
		    Final
		```
