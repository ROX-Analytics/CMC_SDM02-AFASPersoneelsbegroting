		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Volledige Naam' =
			
			IF(
			    'Dim Medewerker/Vacatures'[Flag Medewerker] = 1,
			    'Dim Medewerker/Vacatures'[Achternaam] & " " & "," & " " & 'Dim Medewerker/Vacatures'[Voorletters] & " " & "(" & 'Dim Medewerker/Vacatures'[Voornaam] & ")",
			    'Dim Medewerker/Vacatures'[Voornaam]
			)
		lineageTag: 557d46d5-0401-46af-a62e-29d06f1a3448
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Medewerkers in Fact Forecasting' =
			
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(
			        LOOKUPVALUE(
			            'Fact Forecasting Medewerkers Salaris'[Medewerker ID],
			            'Fact Forecasting Medewerkers Salaris'[Medewerker ID],
			            'Dim Medewerker/Vacatures'[Medewerker ID]
			        )
			    ),1,
			    'Dim Medewerker/Vacatures'[Medewerker ID] IN {"0001", "0002"}, 1,
			    0
			)
		formatString: 0
		lineageTag: 999478e7-ca67-4a5f-94d0-b4fca5eb1639
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cessantia = 40
		formatString: 0
		lineageTag: 75e0eeed-fd2f-4a59-af91-f5e468fbe9b3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Indexering Forecasting' =
			
			IF(
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_3" || 'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_1" || 'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_15" || 'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_10" || 'Dim Medewerker/Vacatures'[Dienstbetrekking ID] = 4,
			    "0",
			    "1"
			)
		lineageTag: 488ada8d-697f-4852-8226-dcbc62216e44
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Feesturen flag' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "3010", "3011", "3012" },
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0 || 'Dim Medewerker/Vacatures'[Flag Medewerker] = 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: c69b03f9-c156-40c9-83a7-4ba3feddf339
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Dienstjaren Forecasting' = 'Dim Medewerker/Vacatures'[Dienstjaren] + 1
		lineageTag: 712083bf-fbe9-4134-80c5-f514a748f545
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Flag 4105000 - Gratificaties' =
			
			// 'Dim Medewerker'[Dienstjaren] IN {12.5, 25, 35, 40}
			IF(
			    'Dim Medewerker/Vacatures'[Dienstjaren Forecasting] = 12.5 || 'Dim Medewerker/Vacatures'[Dienstjaren Forecasting] = 25 || 'Dim Medewerker/Vacatures'[Dienstjaren Forecasting] = 35 || 'Dim Medewerker/Vacatures'[Dienstjaren Forecasting] = 40,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 145f5ba4-b896-4ddc-b1b4-0eed0fdc6aa4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Maaltijdvergoeding' =
			
			IF(
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_1" ||
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_10" ||
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "Z_15" ||
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "S_4" ||
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "S_5" ||
			    'Dim Medewerker/Vacatures'[Type Personeel ID] = "O_4",
			    0,
			    1
			)
		formatString: 0
		lineageTag: 8b6685b8-eff2-4577-91a0-9253c9f5a892
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Overtime 200% and 300% Type Personeel' =
			
			IF(
			    ('Dim Medewerker/Vacatures'[Type Personeel ID] IN {"Z_1", "Z_10", "Z_15"} || CONTAINSSTRING('Dim Medewerker/Vacatures'[Soort_functie], "Echelon 2") || CONTAINSSTRING('Dim Medewerker/Vacatures'[Soort_functie], "Echelon 1")) && 'Dim Medewerker/Vacatures'[Flag Maaltijdvergoeding] = 0,
			    0,
			    1
			)
		formatString: 0
		lineageTag: 5e2ebd9d-516a-4c41-a04e-11b1604ff577
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag LC 3164 - Softlanding' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "3164"},
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: e51ac56d-e97a-435f-8e3c-8a675e87783c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Column
		type: calculated
		lineageTag: f42a7bc1-3c3b-4b12-a9a1-babdf7c7aad5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	column 'Flag Overwerk 200%' =
			
			IF(
			    'Dim Medewerker/Vacatures'[Flag Overtime 200% and 300% Type Personeel] = 1 &&
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "2622"},
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: a5e8d4f8-82e4-44aa-8572-71eaac0e45c5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag GB 4116000 - Medische Kosten Eig Risico' = ```
			
			LOOKUPVALUE(
			    'Dim SchaalType'[SchaalType Forecasting],
			    'Dim SchaalType'[Schaal ID], 'Dim Medewerker/Vacatures'[Schaal ID]
			)
			
			```
		lineageTag: 82cbc6c9-e912-4423-ae12-9b0e945fb6cf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag LC 3021 - Instructievergoeding' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] = "3021",
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 209be682-49f5-4a65-98bf-8dec215ccaa5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag LC 3027 - Speciale Toelage' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] = "3027",
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 5512db06-5a8d-4d65-b584-24803bcde2ed
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'FLag LC 3095 - Vergunning' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "3095"},
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: b4e2c63f-f8bd-4ae4-b292-de332152d620
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag LC - 3091 Ziektekosten WG bijdrage' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "3091"},
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1,
			        'Dim Type Personeel'[Type Personeel ID] IN {"Z_1", "Z_10", "Z_15"}
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: d35d8e1d-ce32-47c1-b3ec-11e47bc2215c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag LC 3142 - Medische Kosten Eig Risico (Eigen Personeel)' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1,
			        'Dim Medewerker/Vacatures'[Flag LC - 3091 Ziektekosten WG bijdrage] = 0,
			        FILTER(
			            ALL('Dim Type Personeel'),
			            'Dim Type Personeel'[Type Personeel ID] <> "Z_1" || 'Dim Type Personeel'[Type Personeel ID] <> "Z_10" || 'Dim Type Personeel'[Type Personeel ID] <> "Z_15"
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: f7a7ea69-fd81-485c-aaff-b809365aeb35
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Overwerk 300%' =
			
			IF(
			    'Dim Medewerker/Vacatures'[Flag Overtime 200% and 300% Type Personeel] = 1 &&
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Medewerkers Salaris'),
			        'Fact Forecasting Medewerkers Salaris'[LC] IN { "3075"},
			        'Dim Medewerker/Vacatures'[Medewerkers in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 2f6c28a4-0a92-4aba-bf18-dc34491a370c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

