	column 'Flag Overtime 200% and 300% Type Personeel' =
			
			IF(
			    ('Dim Vacatures Medewerker'[Flag Medische Specialisten] = 1 || CONTAINSSTRING('Dim Vacatures Medewerker'[Soort_functie], "Echelon 2") || CONTAINSSTRING('Dim Vacatures Medewerker'[Soort_functie], "Echelon 1")) && 'Dim Vacatures Medewerker'[Flag Maaltijdvergoeding] = 0,
			    0,
			    1
			)
		formatString: 0
		lineageTag: 41ec8bd2-0819-45a6-911c-4745e27b16b5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

