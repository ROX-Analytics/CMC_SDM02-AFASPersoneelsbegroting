	column 'Feesturen flag' =
			
			IF(
			    CALCULATE(
			        COUNTROWS('Fact Forecasting Vacatures'),
			        'Dim Vacatures Medewerker'[Flag Vacatures in Fact Forecasting] = 1
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 1e2d974e-94c4-4aa5-b4ba-f59a57baff34
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Vacatures in Fact Forecasting' =
			
			IF(
			    NOT ISBLANK(
			        LOOKUPVALUE(
			            'Fact Forecasting Vacatures'[Formatieplaats],
			            'Fact Forecasting Vacatures'[Formatieplaats],
			            'Dim Vacatures Medewerker'[Formatieplaats]
			        )
			    ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 483ee1da-fda0-4979-9c68-e2bdea96fdbb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Medische Specialisten' =
			
			IF(
			    'Dim Vacatures Medewerker'[Type Zorg Functie] = "Medisch Specialisten",
			    1,
			    0
			)
		formatString: 0
		lineageTag: 1fb2b5ab-a1cd-4a01-9011-e4cd55045f51
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Maaltijdvergoeding' =
			
			IF(
			    'Dim Vacatures Medewerker'[Flag Medische Specialisten] = 1 ||
			    'Dim Vacatures Medewerker'[Type Personeel ID] = "S_4" ||
			    'Dim Vacatures Medewerker'[Type Personeel ID] = "S_5" ||
			    'Dim Vacatures Medewerker'[Type Personeel ID] = "O_4",
			    0,
			    1
			)
		formatString: 0
		lineageTag: 40057c84-3d10-48c3-b95a-dc62003d51a5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Flag Arts-Assistenten' =
			
			IF(
			    'Dim Vacatures Medewerker'[Type Zorg Functie] = "Arts-assistenten",
			    1,
			    0
			)
		formatString: 0
		lineageTag: 918cb75c-8583-4d71-87d0-886b8bd0d858
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Formatieplaats Coded + Omschrijving' = 'Dim Vacatures Medewerker'[Formatieplaats] & " " & "-" & " " & 'Dim Vacatures Medewerker'[Formatieplaats Omschrijving] & " " & "-" & " " & 'Dim Vacatures Medewerker'[Nr van Vacature]
