			    RELATED('Dim Medewerker'[Flag GB 4125100 - Personeel niet in loondienst]) = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 24825f57-4651-4f83-8220-1374f32464fe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

