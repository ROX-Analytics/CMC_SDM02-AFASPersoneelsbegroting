	column '(M) GB 4105000 - Gratificaties' = ```
			
			
			VAR selectedDienstJaren = 'Fact Forecasting Medewerkers'[Dienstjaren Medewerker Forecasting]
			VAR anniversarymonth = 'Fact Forecasting Medewerkers'[Anniversary Month]
			VAR period = 'Fact Forecasting Medewerkers'[Period]
			
			
			VAR basesalary = 'Fact Forecasting Medewerkers'[(M) LC 2434 - Salaris]
			
			VAR dienstjubileum =
			IF(
			    anniversarymonth = period,    
			SWITCH(
			    TRUE(),
			    selectedDienstJaren = 12.5, basesalary,
			    selectedDienstJaren = 25, 2 * basesalary,
			    selectedDienstJaren = 35, 2.5 * basesalary,
			    selectedDienstJaren = 45, 3 * basesalary,
			    BLANK()
			),
			BLANK()
			)
			RETURN
			dienstjubileum
			```
		lineageTag: ee13c3eb-9dca-495c-b428-606f7c0c78a4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

