	column '(M) GB 4215000 - Overige Jubileum kosten' = ```
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			VAR period = 'Fact Forecasting Medewerkers'[Period]
			VAR anniversary = 'Fact Forecasting Medewerkers'[Anniversary Month]
			VAR selectedDienJaren = 'Fact Forecasting Medewerkers'[Flag Dienstjaren Forecasting]
			
