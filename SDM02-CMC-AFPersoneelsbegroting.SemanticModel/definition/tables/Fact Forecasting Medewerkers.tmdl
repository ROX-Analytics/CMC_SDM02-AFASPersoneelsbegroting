	column '(M) LC 3080 - Beroepskosten (Specialisten)' = ```
			
			//  Arts-assistenten
			// 4120000
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			
			
			VAR beroepkosten = DIVIDE(14000, 12)
			    // TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			//      'Dim Type Personeel'[Type Zorg Functie] <> "Arts-assistenten",
			//     'Dim SchaalType'[SchaalType Forecasting] IN {"LNT", "Andere OVK"},
			//     'Dim Type Personeel'[Type Zorg Functie] = " Medisch Specialisten"
			// )
			
			VAR beroepkostenFTE = beroepkosten * 'Fact Forecasting Medewerkers'[FTE (Divided by 100)]
			VAR result =
			IF(
			    selectedGL = "4120000" && selectedLC = "3080" && 'Fact Forecasting Medewerkers'[Type Personeel ID] IN {"Z_1", "Z_10", "Z_15"},
			    beroepkostenFTE,
			    BLANK()
			)
			RETURN
			result
			
			
			```
		lineageTag: 6032a304-9f27-4560-848f-59b062442ae3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '(M) LC 3091 - Ziektekosten WG bijdrage (Specialisten)' = ```
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag LC - 3091 Ziektekosten WG bijdrage] = 1 && 
			    'Dim Medewerker'[Status_dienstverband] = "In dienst" && 
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			VAR FTE = 'Fact Forecasting Medewerkers'[FTE (Divided by 100)]
			
			VAR kosten = DIVIDE(13000, 12, BLANK()) * FTE
			
			RETURN
			IF(
			    selectedGL = "4117000" && selectedLC = "3091" && 'Fact Forecasting Medewerkers'[Type Personeel ID] IN {"Z_1", "Z_10", "Z_15"} && RELATED('Dim Medewerker'[Flag LC - 3091 Ziektekosten WG bijdrage]) = 1, 
			    kosten,
			    BLANK()
			)
			```
		lineageTag: 58c17f82-bf58-4f5e-aebb-19ee0b636295
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '(M) LC 3095 - Vergunning' = ```
			
			// 4125500
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			VAR glisinscope = ISINSCOPE('Dim Grootboek'[Code Grootboek])
			VAR LCisinscope = ISINSCOPE('Dim Looncomponent'[LC])
			
			VAR countmedewerkers = 
			CALCULATE(
			    [Count Medewerkers],
			    ALL('Dim Medewerker'),
			    'Dim Medewerker'[FLag LC 3095 - Vergunning] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 &&
			    'Dim Medewerker'[FLag LC 3095 - Vergunning] = 1 && 
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR kosten = 
			CALCULATE(
			    [(A) LC 3095 - Vergunningen],
			    basesetmedewerker
			)
			
			VAR totalekosten = DIVIDE(kosten, countmedewerkers, BLANK())
			
			VAR medewerkerkosten = 
			SUMX(
			    basesetmedewerker,
			    totalekosten
			)
			
			RETURN
			IF(
			
			    selectedGL = "4125500" && selectedLC = "3095", 
			    totalekosten,
			    BLANK()
			)
			```
		lineageTag: b5c577a1-440f-4963-8a1d-7b2ca60def07
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '(M) WN Bijdrage pensioen (CAO)' = ```
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			VAR selectedschaaltype = 'Fact Forecasting Medewerkers'[SchaalType Forecasting]
			VAR BasesalariesGL = 'Fact Forecasting Medewerkers'[(M) LC 2434 - Salaris]
			VAR maandenindienst = 'Fact Forecasting Medewerkers'[Maanden In Dienst]
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedschaaltype = "CAO", 
			    BasesalariesGL * 0.05 * maandenindienst,
			    BLANK()
			)
