	column '(M) GB 4125100 - Personeel niet in Loondienst' = ```
			
			VAR selectedGL = 'Fact Forecasting Medewerkers'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Medewerkers'[LC]
			VAR personeelflag = 'Fact Forecasting Medewerkers'[Flag Personeel Niet in Loondienst]
			VAr basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag GB 4125100 - Personeel niet in loondienst] = 1 &&
			    'Dim Medewerker'[Status_dienstverband] = "In dienst" && 
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			
			VAR countmedewerkers = 
			CALCULATE(
			    COUNTROWS('Dim Medewerker'),
			    ALL('Dim Medewerker'),
			    basesetmedewerker
			)
			VAR total = [(WA) GB 4125100 - Personeel niet in Loondienst]
			
			VAR personeelnietinloondienst = 
			CALCULATE(
			    DIVIDE([(WA) GB 4125100 - Personeel niet in Loondienst], countmedewerkers, BLANK()),
			    basesetmedewerker,
			    'Fact Forecasting Medewerkers'[Flag Personeel Niet in Loondienst] = 1
			)
			
			RETURN
			IF(
			    selectedGL = "4125100" && selectedLC = "0001" && personeelflag = 1, 
			    DIVIDE(personeelnietinloondienst, 12, BLANK()),
			    BLANK()
			)
			```
