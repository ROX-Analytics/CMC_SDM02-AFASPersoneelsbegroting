	column '(V) LC 3080 Beroepkosten (Specialisten)' =
			
			VAR selectedGL = 'Fact Forecasting Vacatures'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Vacatures'[LC]
			VAR medspec = 'Fact Forecasting Vacatures'[Flag Medische Specialisten]
			RETURN
			IF(
			    selectedLC = "3080" && medspec = 1,
			    DIVIDE(14000, 12, BLANK()) * 'Fact Forecasting Vacatures'[Verschil per Vac (FTE)],
			    BLANK()
			)
		lineageTag: 7ef6933a-64d0-4233-a532-34bb2f3cee34
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '(V) GB 4114000 - Cessantia' = ```
			
			VAR selectedGL = 'Fact Forecasting Vacatures'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Vacatures'[LC]
			
			
			
			RETURN
			IF(
			    selectedGL = "4114000" && selectedLC = "0001",
			    DIVIDE(40,12,BLANK()),
			    BLANK()
			)
			
			
			
			```
		lineageTag: 9b5de2b8-66c3-4144-a679-c139be16b007
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '(V) GB 4101100 - Maaltijd Vergoeding' = ```
			
			VAR selectedGl = 'Fact Forecasting Vacatures'[Grootboekrekening]
			VAR selectedLC = 'Fact Forecasting Vacatures'[LC]
			VAR FTE =
			CALCULATE(
			    [FTE Forecasting Medewerker (max period at total)],
			    ALL('Dim Looncomponent'),
			    ALL('Dim Grootboek'),
			    ALL('Dim Medewerker')
			)
			VAR ratio = DIVIDE(15000, FTE)
			
			VAR amount = ratio * 'Fact Forecasting Vacatures'[Verschil per Vac (FTE)]
			
			RETURN
			IF(
			    selectedGl = "4101100" && selectedLC = "0001" && RELATED('Dim Medewerker'[Flag Maaltijdvergoeding]) = 1,
			    DIVIDE(amount, 12, BLANK()),
			    BLANK()
			)
			
			```
		lineageTag: e5b81b40-496f-4033-a510-8c36bb329077
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

