				    #"Merged Queries" = Table.NestedJoin(#"Inserted Year", {"Formatieplaats"}, #"Dim Vacature per Verschil FTE Test", {"Formatieplaats"}, "Dim Vacature per Verschil FTE Test", JoinKind.LeftOuter),
				    #"Expanded Dim Vacature per Verschil FTE Test" = Table.ExpandTableColumn(#"Merged Queries", "Dim Vacature per Verschil FTE Test", {"Verschil (excl)", "Medewerker ID"}, {"Verschil (excl)", "Medewerker ID"}),
