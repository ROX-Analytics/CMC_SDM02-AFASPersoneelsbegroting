	column '(M) LC 3091 - WG Ziektekosten Specialisten' =
			
			VAR flagmedspec = 'Fact Forecasting Vacatures'[Flag Medische Specialisten]
			VAR selectedLC = 'Fact Forecasting Vacatures'[LC]
			RETURN
			IF(
			    flagmedspec = 1 && selectedLC = "3091",
			    DIVIDE(13000, 12, BLANK()),
			    BLANK()
			)
