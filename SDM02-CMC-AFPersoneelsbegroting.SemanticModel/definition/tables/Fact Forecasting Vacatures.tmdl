				    #"Added Custom Perc Key" = Table.AddColumn(#"Renamed Columns4", "Percentage Key", each if [SchaalType] = "CAO" then Text.From([Percentage Name CAO]) & "_" & Text.From([SchaalType]) else if [SchaalType] = "LNT" then Text.From([Percentage Name LNT]) & "_" & Text.From([SchaalType]) else null, type nullable text),
				    #"Added Salaris Perc" = Table.AddColumn(#"Added Custom Perc Key", "Salaris (incl %)", each if [SchaalType] = "CAO" then ([Bruto Salaris] * [Percentage CAO]) else if [SchaalType] = "LNT" then ([Bruto Salaris] * [Percentage LNT]) else null, type nullable number),
				
				    IndexVac = Table.Buffer(#"Dim Indexering Vacatures"),
				
				    #"Added Dim Index Vac" = Table.AddColumn(#"Added Salaris Perc", "Dim Indexering Vacatures", each IndexVac),
