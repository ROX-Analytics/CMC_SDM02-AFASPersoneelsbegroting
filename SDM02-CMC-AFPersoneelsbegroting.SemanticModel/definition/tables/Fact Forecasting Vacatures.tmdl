				    #"Expanded Support" = Table.ExpandTableColumn(#"DimLCperGLSupport", "Dim LC per GB", {"LC", "Omschrijving LC", "Grootboekrekening", "Grootboekrekening_omschrijving"}, {"LC", "Omschrijving LC", "Grootboekrekening", "Grootboekrekening_omschrijving"}),
				
				    DimPerCAO = Table.Buffer(#"Dim Percentage Vacature CAO"), // Buffer table to increase performance
				    DimPerLNT = Table.Buffer(#"Dim Percentage Vacature LNT"), // Buffer table to increase performance
				
				    #"Merged Dim Per CAO" = Table.NestedJoin(#"Expanded Support", {"SchaalType"}, DimPerCAO, {"SchaalType"}, "Dim Percentage Vacature CAO", JoinKind.LeftOuter),
				    #"Expanded Dim Percentage Vacature CAO" = Table.ExpandTableColumn(#"Merged Dim Per CAO", "Dim Percentage Vacature CAO", {"Percentage", "Percentage Name"}, {"Percentage", "Percentage Name"}),
				    #"Renamed Columns3" = Table.RenameColumns(#"Expanded Dim Percentage Vacature CAO",{{"Percentage", "Percentage CAO"}, {"Percentage Name", "Percentage Name CAO"}}),
				    #"Merged Dim Per LNT" = Table.NestedJoin(#"Renamed Columns3", {"SchaalType"}, DimPerLNT, {"SchaalType"}, "Dim Percentage Vacature LNT", JoinKind.LeftOuter),
				    #"Expanded Dim Percentage Vacature LNT" = Table.ExpandTableColumn(#"Merged Dim Per LNT", "Dim Percentage Vacature LNT", {"Percentage", "Percentage Name"}, {"Percentage", "Percentage Name"}),
