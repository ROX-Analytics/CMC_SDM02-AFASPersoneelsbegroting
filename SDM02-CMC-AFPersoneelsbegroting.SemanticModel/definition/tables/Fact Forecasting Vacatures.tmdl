	column 'WN bijdrage pensioen (LNT)' =
			
			VAR salaris = 'Fact Forecasting Vacatures'[Salaris Incl Indexering * (Verschil FTE)]
			VAR schaaltype = 'Fact Forecasting Vacatures'[SchaalType]
			
			RETURN
			IF(
			    schaaltype = "LNT",
			    salaris * 0.10
			)
		lineageTag: e1e158f9-af0c-4932-bf9f-4cc4903df915
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'WN bijdrage pensioen (CAO)' =
			
			VAR salaris = 'Fact Forecasting Vacatures'[Salaris Incl Indexering * (Verschil FTE)]
			VAR schaaltype = 'Fact Forecasting Vacatures'[SchaalType]
			
			RETURN
			IF(
			    schaaltype = "CAO",
			    salaris * 0.05 * 12,
			    BLANK()
			)
		lineageTag: bf41bcec-ef98-4ee8-9f6c-5f4258a0e4e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

