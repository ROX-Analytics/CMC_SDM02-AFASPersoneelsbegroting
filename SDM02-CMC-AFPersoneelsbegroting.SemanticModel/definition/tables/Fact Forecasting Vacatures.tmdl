				    #"Expanded Dim Period" = Table.ExpandTableColumn(#"Merged Dim Period", "Dim Period", {"Month no.", "Year/Period"}, {"Month no.", "Year/Period"}),
				
				    DimLCperGB = Table.Buffer(#"Dim LC per GL Support"),
				
