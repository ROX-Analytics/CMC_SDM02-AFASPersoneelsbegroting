			    glisinscope || LCisinscope,
			SWITCH(
			    TRUE(),
			    selectedGL = "4102200" && selectedLC = "2636", Basesalaries * 0.0013,
			    selectedGL = "4102200" && NOT HASONEVALUE('Dim Looncomponent'[LC]), Basesalaries * 0.0013,
			    BLANK()
