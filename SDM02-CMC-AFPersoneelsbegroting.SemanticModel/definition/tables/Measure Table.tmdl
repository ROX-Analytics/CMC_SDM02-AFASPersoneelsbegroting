			    selectedGL = "4103000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), amount,
			    selectedLC = "3010" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), amount,
			    BLANK()
