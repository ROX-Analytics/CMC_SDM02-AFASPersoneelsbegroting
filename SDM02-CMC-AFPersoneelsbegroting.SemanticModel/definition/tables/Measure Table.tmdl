	measure '(M) LC 3080 - Beroepskosten (Specialisten)' = ```
			
			//  Arts-assistenten
			// 4120000
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			
			VAR BaseSalariesLC = 
			CALCULATE(
			   (DIVIDE(14000, 12) * [FTE Forecasting Medewerker]),
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			     'Dim Type Personeel'[Type Zorg Functie] <> "Arts-assistenten",
			    'Dim SchaalType'[SchaalType Forecasting] IN {"LNT", "Andere OVK"},
			    'Dim Type Personeel'[Type Zorg Functie] = " Medisch Specialisten"
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4120000" && selectedLC = "3080", BaseSalariesLC,
			    selectedGL = "4120000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), BaseSalariesLC,
			    selectedLC = "3080" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), BaseSalariesLC,
			    BLANK()
			)
