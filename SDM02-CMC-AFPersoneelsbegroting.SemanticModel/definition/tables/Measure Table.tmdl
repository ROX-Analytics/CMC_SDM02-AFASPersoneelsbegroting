	measure '(A) LC 3086 Feesturen Actuals' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			VAR feesturenbase = 
			CALCULATE(
			    [Bedrag Journal Entries],
			    'Dim Grootboek'[Code Grootboek] = "4101500",
			    ALL('Dim Grootboek'),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			
			RETURN
			CALCULATE(
			    DIVIDE(feesturenbase ,yearforaverage, 0),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek')
			)
			```
		displayFolder: Statistics\Averages
		lineageTag: c58668b7-ad35-4d18-a2cf-4a098551726d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LC 3086 - Feesturen VAR' =
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			RETURN
			IF(
			    NOT ISBLANK([(M) LC 2434 - Salaris]),
			    CALCULATE(
			        VAR.S('Fact Personeels Kosten'[LC - 3086 Feesturen]),
			        FILTER(
			            ALL('Dim Period'),
			            'Dim Period'[Year] >= minyear
			            && 'Dim Period'[Year] <= currentyear - 1
			        ),
			        'Fact Forecasting Medewerkers'[LC] = "3086"
			    ),
			    BLANK()
			)
		formatString: #,0.00
		displayFolder: Statistics\Variance & Weights
		lineageTag: ac6cb1af-d0bf-46ab-9ac9-cc1e633d221d

	measure '(A) LC 2622 Overtime 200% Actuals' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
