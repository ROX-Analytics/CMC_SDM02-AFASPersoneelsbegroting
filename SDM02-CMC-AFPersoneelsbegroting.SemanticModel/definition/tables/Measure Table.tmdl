	measure '(M) GB 4125100 - Personeel niet in Loondienst' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			VAR countmedewerkers = 
			CALCULATE(
			    [Count Medewerkers],
			    ALL('Dim Medewerker'),
			    'Dim Medewerker'[Flag Maaltijdvergoeding] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 &&
			    'Dim Medewerker'[Flag Maaltijdvergoeding] = 1 && 
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR personeelnietinloondienst = 
			CALCULATE(
			    DIVIDE([(A) GB 4125100 - Personeel niet in Loondienst], countmedewerkers, BLANK())
			)
			
			VAR selectedkoers = SELECTEDVALUE('Dagkoers EURO/USD'[Dagkoers])
			
			VAR erasmuskosten = 
			CALCULATE(
			    DIVIDE(SUM('Dagkoers EURO/USD'[Bedrag Erasmus in XCG]), countmedewerkers, BLANK()),
			    'Dagkoers EURO/USD'[Dagkoers] = selectedkoers
			)
			
			
			VAR totalekosten =
			SUMX(
			    basesetmedewerker,
			    personeelnietinloondienst + erasmuskosten
			)
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4125100" && selectedLC = "0001", totalekosten,
			    selectedGL = "4125100" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten,
			    BLANK()
			)
			
			```
