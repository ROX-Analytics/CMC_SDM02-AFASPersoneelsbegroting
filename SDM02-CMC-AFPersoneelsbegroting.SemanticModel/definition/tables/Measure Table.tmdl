	measure '(A) GB 4121000 - Uitzendkrachten en Tijdelijke Personeel' = ```
			
			VAR currentmonth = MONTH(TODAY())
			VAR minmonth = MIN('Dim Period'[Month no.])
			VAR selectedyear = YEAR(TODAY())
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Month no.] >= minmonth
			    && 'Dim Period'[Month no.] <= currentmonth
			)
			
			
			VAR maandenMetKosten =
			    COUNTROWS(
			        FILTER(
			            ALL('Dim Period'),
			            'Dim Period'[Year] = selectedYear &&
			            'Dim Period'[Month no.] >= minMonth &&
			            'Dim Period'[Month no.] <= currentMonth &&
			            CALCULATE(
			                [Bedrag Journal Entries],
			                'Dim Grootboek'[Code Grootboek] = "4121000",
			                'Dim Period'[Year] = selectedYear
			            ) <> 0
			        )
			    )
			
			-- Total cost in selected year
			VAR kosten =
			    CALCULATE(
			        [Bedrag Journal Entries],
			        'Dim Grootboek'[Code Grootboek] = "4121000",
			        'Dim Period'[Year] = selectedYear
			    )
			
			RETURN
			CALCULATE(
			    DIVIDE(kosten, maandenMetKosten, BLANK()),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek')
			)
			```
