	measure '(CM2) FTE Actuals Extrapolated' = ```
			
			VAR selectedyear = SELECTEDVALUE('Dim Period'[Year])
			VAR selectedperiod = SELECTEDVALUE('Dim Period'[Month no.])
			
			VAR maxperiod = 
			CALCULATE(
			    MAX('Fact Salaris Indexering Actuals'[Year/Period]),
			    'Dim Period'[Year] = selectedyear,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			RETURN
			IF(
			    selectedperiod,
			    CALCULATE(
			        DIVIDE(SUM('Fact Salaris Indexering Actuals'[FTE]), 12, BLANK()),
			        'Dim Period'[Month no.] = selectedperiod,
			        'Dim Period'[Year] = selectedyear
			    ),
			    CALCULATE(
