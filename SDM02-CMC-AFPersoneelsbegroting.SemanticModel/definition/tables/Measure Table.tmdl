			VAR maxPeriod =
			    CALCULATE(
			        MAX('Dim Period'[Month no.]),
			        REMOVEFILTERS('Dim Period')        // removes month-level filters for correct total
			    )
			VAR maxFTE =
			    CALCULATE(
			        SUM('Fact Forecasting Vacatures'[Verschil per Vac (FTE)]),
			        'Dim Period'[Month no.] = maxPeriod,
			        'Dim Looncomponent'[LC] = "2434"
			    )
			
			RETURN
			IF(
			    selectedPeriod,
			    CALCULATE(
			        SUM('Fact Forecasting Vacatures'[Verschil per Vac (FTE)]),
			        'Dim Period'[Month no.] = selectedPeriod,
			        'Dim Looncomponent'[LC] = "2434"
