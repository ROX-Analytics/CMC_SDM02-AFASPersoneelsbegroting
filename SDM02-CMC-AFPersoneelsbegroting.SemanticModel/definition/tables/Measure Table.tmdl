	measure 'Verschil Budget' = [Bedrag Budget] - [Bedrag Budget PY]
		displayFolder: Budget
		lineageTag: 1b6fb24a-eede-4d51-aee9-8b9c35fb43be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Verschil Budget' = DIVIDE([Verschil Budget], [Bedrag Budget PY])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Budget
		lineageTag: 38b73d5a-4269-46d7-9401-c42f9b8afc84

	partition 'Measure Table' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", Int64.Type}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

