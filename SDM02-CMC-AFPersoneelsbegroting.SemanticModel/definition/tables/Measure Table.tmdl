	measure 'Bedrag Incl Indexering Actuals' = ```
			
			VAR indexeringFactor = SELECTEDVALUE('Dim Indexering Actuals'[Indexering], 1)
			VAR monthCount = DISTINCTCOUNT('Dim Period'[Month no.])
			VAR monthValue = SELECTEDVALUE('Dim Period'[Month no.])
			
			-- BASE: unfiltered values
			VAR actualsAmount =
			    CALCULATE(
			        SUM('Fact Salaris Indexering Actuals'[Bedrag (New)]),
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] < 7
			    )
			
			VAR indexeringAmount =
			    CALCULATE(
			        SUM('Fact Salaris Indexering Actuals'[Bedrag (New)]) * indexeringFactor +
			        SUM('Fact Salaris Indexering Actuals'[Bedrag (New)]),
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] >= 7
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    -- exactly one month selected
			    monthCount = 1 && monthValue < 7, actualsAmount,
			    monthCount = 1 && monthValue >= 7, indexeringAmount,
			    -- otherwise (multiple or no months selected)
			    actualsAmount + indexeringAmount
			)
			
			```
		displayFolder: Forecasting
		lineageTag: 4286c08b-a988-4873-9b9c-774899bfe0b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '(M) New Bedrag Inclusief Indexering Forecasting' = ```
			
			VAR selectedindexering = SELECTEDVALUE('Dim Indexering Forecasting'[Indexering])
			VAR selectedperiod = SELECTEDVALUE('Dim Period'[Month no.])
			VAR hasSingleValue = HASONEVALUE('Dim Period'[Month no.])
			
			VAR BaseActuals = 
			IF(
			    hasSingleValue,
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]),
			        'Fact Forecasting Medewerkers'[Period] < 7,
			        'Dim Period'[Month no.] = selectedperiod,
			        'Dim Medewerker'[Flag Indexering Forecasting] = "1"
			    ),
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]),
			        'Fact Forecasting Medewerkers'[Period] < 7,
			        'Dim Medewerker'[Flag Indexering Forecasting] = "1"
			    )
			)
			
			VAR BaseIndexering = 
			IF(
			    hasSingleValue,
			    CALCULATE(
			        (SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]) * selectedindexering) + SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]),
			        'Fact Forecasting Medewerkers'[Period] >= 7,
			        'Dim Period'[Month no.] = selectedperiod,
			        'Dim Medewerker'[Flag Indexering Forecasting] = "1"
			    ),
			    CALCULATE(
			        (SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]) * selectedindexering) + SUM('Fact Forecasting Medewerkers'[Salaris Base Forecasting]),
			        'Fact Forecasting Medewerkers'[Period] >= 7,
			        'Dim Medewerker'[Flag Indexering Forecasting] = "1"
			    )
			)
			
			RETURN
			IF(
			    hasSingleValue,
			    IF(selectedperiod < 7, BaseActuals, BaseIndexering),
			    BaseActuals + BaseIndexering
			)
			```
		displayFolder: Forecasting\Medewerker
		lineageTag: 6e74c32e-1e1f-44da-81ec-1f1fc0ef0b0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

