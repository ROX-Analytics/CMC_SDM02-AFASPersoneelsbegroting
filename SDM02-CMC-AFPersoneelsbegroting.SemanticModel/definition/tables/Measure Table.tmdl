	measure 'LC 3014 - Frequentietoeslag' = ```
			
			VAR currentyear = YEAR(TODAY())
			
			
			VAR huidigekosten = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    ALL('Dim Looncomponent'),
			    'Dim Looncomponent'[LC] = "3014",
			    'Dim Medewerker'[Flag Medische Specialisten] = 1,
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] = currentyear
			    )
			)
			
			
			RETURN
			CALCULATE(
			    huidigekosten,
			    ALL('Dim Period'),
			    ALL('Dim Looncomponent'),
			    ALL('Dim Grootboek')
			)
			```
