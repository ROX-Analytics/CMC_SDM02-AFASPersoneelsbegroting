	measure '(M) LC 3010 - Schemawerk 30%' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag Overwerk Schemawerk 30%] = 1 && 
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 && 
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR totaleFTE = 
			CALCULATE(
			    'Measure Table'[FTE Forecasting Medewerker],
			    basesetmedewerker,
			    REMOVEFILTERS()
			)
			VAR FTE = 
			CALCULATE(
			    'Measure Table'[FTE Forecasting Medewerker],
			    basesetmedewerker
			)
			
			VAR averageschemawerk = 'Measure Table'[(A) LC 3010 Schemawerk 30%]
			
			VAR schemawerk = DIVIDE(averageschemawerk, FTE * totaleFTE, BLANK())
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedLC = "3010" && selectedGL = "4103000", schemawerk,
			    selectedGL = "4103000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), schemawerk,
			    selectedLC = "3010" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), schemawerk,
			    BLANK()
			)
			
			```
		displayFolder: Forecasting\Medewerker
		lineageTag: a5c2eae5-7df7-48cb-be25-de496b20d57c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '(A) LC 3010 Schemawerk 30%' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			VAR schemawerk = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    'Dim Looncomponent'[LC] = "3010",
			    ALL('Dim Looncomponent'),
			    ALL('Dim Grootboek'),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			
			RETURN
			CALCULATE(
			    DIVIDE(schemawerk ,yearforaverage, 0),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek'),
			    ALL('Dim Looncomponent')
			)
			```
		formatString: 0.00
		displayFolder: Statistics\Averages
