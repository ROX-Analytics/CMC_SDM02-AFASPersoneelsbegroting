	measure 'Totale Bedrag Medewerker Forecasting' = ```
			
			VAR Medewerker =
			SUMX(
			    'Dim Grootboek',
			    'Measure Table'[(M) GB 4101100 - Maaltijd Vergoeding] + 
			    'Measure Table'[(M) GB 4105000 - Gratificaties] + 
			    'Measure Table'[(M) GB 4106000 - Bijzondere Vergoedingen] + 
			    'Measure Table'[(M) GB 4114000 - Cessantia] + 
			    'Measure Table'[(M) GB 4118000 - Medische Uitzendkosten] +
			    'Measure Table'[(M) GB 4121000 - Uitzendkrachten en Tijdelijk] + 
			    'Measure Table'[(M) GB 4121500 - Kosten Stagaires] +
			    'Measure Table'[(M) GB 4125100 - Personeel niet in Loondienst] +
			    'Measure Table'[(M) GB 4125500 - Overige Personeelskosten] +
			    'Measure Table'[(M) GB 4215000 - Overige Jubileum kosten] +
			    'Measure Table'[(M) LC 2434 - Salaris] + 
			    'Measure Table'[(M) LC 2545 - Pensioen Toeslag] +
			    'Measure Table'[(M) LC 2622 - Overwerk 200%] + 
			    'Measure Table'[(M) LC 2636 - Uitbetaling verlofuren] +
			    'Measure Table'[(M) LC 2807 - WG bijdrage premie AOV/AWW] +
			    'Measure Table'[(M) LC 2809 - AVBZ premie] +
			    'Measure Table'[(M) LC 3010 - Schemawerk 30%] + 
			    'Measure Table'[(M) LC 3011 - Schemawerk 45%] + 
			    'Measure Table'[(M) LC 3012 - Schemawerk 50%] +
			    'Measure Table'[(M) LC 3014 - Frequentietoeslag] +
			    'Measure Table'[(M) LC 3015 - Intensiteitstoeslag] +
			    'Measure Table'[(M) LC 3019 - StandbyToeslag] + 
			    'Measure Table'[(M) LC 3021 - Instructievergoeding] +
			    'Measure Table'[(M) LC 3026 - Wachttoelage] +
			    'Measure Table'[(M) LC 3075 - Overwerk 300%] + 
			    'Measure Table'[(M) LC 3077 - Onregelmatigheidstoeslag] + 
			    'Measure Table'[(M) LC 3078 - Begrafeniskosten] +
			    'Measure Table'[(M) LC 3080 - Beroepskosten (Specialisten)] +
			    'Measure Table'[(M) LC 3082 - Huis- en inrichtingskosten] +
			    'Measure Table'[(M) LC 3083 - Studiekosten] + 
			    'Measure Table'[(M) LC 3086 - Feesturen] +
			    'Measure Table'[(M) LC 3091 - Ziektekosten WG bijdrage (Specialisten)] +
			    'Measure Table'[(M) LC 3095 - Vergunning] +
			    'Measure Table'[(M) LC 3105 - Pensioen Toeslag (LNT & AOVK)] +
			    'Measure Table'[(M) LC 3121 - Reservering Vakantiegeld Bedrag] + 
			    'Measure Table'[(M) LC 3135 - Vakantietoeslag Med Spec] +
			    'Measure Table'[(M) LC 3142 - Medische Kosten Eig Risico (Eigen Personeel)] +
			    'Measure Table'[(M) LC 3164 - Softlanding]
			)
			
			VAR RvC = [(M) GB 4126000 - RvC Kosten]
			
			RETURN
			Medewerker + RvC
			```
