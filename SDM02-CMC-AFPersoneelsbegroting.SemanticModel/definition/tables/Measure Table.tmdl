	measure '(T) Maanden in Dienst' = ```
			
			VAR maxmonths = MAX('Dim Period'[Month no.])
			VAR minmonths = MIN('Dim Period'[Month no.])
			VAR selectedyear = SELECTEDVALUE('Dim Period'[Year])
			VAR Baseset = 
			SUMMARIZE(
			    FILTER(
			        'Fact Salaris Indexering Actuals',
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] <= maxmonths ||
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] >= minmonths
			    ),
			    'Fact Salaris Indexering Actuals'[Medewerker ID],
			    'Fact Salaris Indexering Actuals'[Boekingsperiode]
			)
			
			RETURN
			CALCULATE(
			    COUNTROWS(Baseset),
			    ALL('Dim Period')
			)
			```
		formatString: 0
		displayFolder: Statistics\Extrapolation
		lineageTag: fee9aa64-a0c7-4ae5-b102-29f8ac286381

	measure 'FTE Forecasting Medewerker (max period at total)' = ```
			
			VAR selectedPeriod = SELECTEDVALUE('Dim Period'[Month no.])
			VAR selectedYear = SELECTEDVALUE('Dim Period'[Year])
			VAR maxPeriod =
			    CALCULATE(
			        MAX('Dim Period'[Month no.]),
			        REMOVEFILTERS('Dim Period')        // removes month-level filters for correct total
			    )
			VAR maxFTE =
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[FTE (Divided by 100)]),
			        'Dim Looncomponent'[LC] = "2434",
			        'Dim Period'[Month no.] = maxPeriod
			    )
			
			RETURN
			IF(
			    ISINSCOPE('Dim Period'[Month no.]),
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[FTE (Divided by 100)]),
			        'Dim Looncomponent'[LC] = "2434"
			    ),
			    maxFTE
			)
			
			
			```
