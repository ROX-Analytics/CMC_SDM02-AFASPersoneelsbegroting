			// 4104000
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 2
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			VAR kosten =
			CALCULATE(
			    [Bedrag Journal Entries],
			    'Dim Grootboek'[Code Grootboek] = "4104000",
			    FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			RETURN
			CALCULATE(
			    DIVIDE(kosten, yearforaverage, BLANK()),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek')
			)
