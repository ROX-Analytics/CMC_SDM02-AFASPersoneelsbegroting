	measure '(A) LC 3075 Overtime 300% Actuals' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			VAR overtimebase = 
			CALCULATE(
			    [Bedrag Journal Entries],
			    'Dim Grootboek'[Code Grootboek] = "4101000",
			    ALL('Dim Grootboek'),
			    BaseYearSet
			)
			
			
			
			RETURN
			CALCULATE(
			    DIVIDE(overtimebase, yearforaverage, BLANK()),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek')
			)
			```
		displayFolder: Statistics\Averages
		lineageTag: 6b1f8f9a-e8a4-42ed-939b-ff6d98eed5c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '(M) LC 3075 - Overwerk 300%' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			VAR total = [(A) LC 3075 Overtime 300% Actuals]
			
			VAR countmedewerkers = 
			CALCULATE(
			    [Count Medewerkers],
			    ALL('Dim Medewerker'),
			    'Dim Medewerker'[Flag Overwerk 300%],
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag Overwerk 300%] = 1 &&
			    'Dim Medewerker'[Status_dienstverband] = "In dienst" &&
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			
			VAR kosten = CALCULATE(DIVIDE(total, countmedewerkers, BLANK()))
			
			VAR totalekosten = 
			SUMX(
			    basesetmedewerker,
			    kosten
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4101000" && selectedLC = "3075", totalekosten,
			    selectedGL = "4101000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten,
			    selectedLC = "3075" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), totalekosten,
			    BLANK()
			)
			```
		displayFolder: Forecasting\Medewerker
		lineageTag: d55c511c-3235-4d6a-b991-14bed9010e41

