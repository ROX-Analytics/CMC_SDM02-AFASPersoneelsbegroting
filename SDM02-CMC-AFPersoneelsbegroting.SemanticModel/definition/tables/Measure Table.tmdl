	measure '(M) WN Bijdrage Pensioen (RvB)' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR selectedschaaltype = SELECTEDVALUE('Dim SchaalType'[SchaalType Forecasting])
			// 4115000
			
			VAR Karina = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers] * 0.05,
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Medewerker ID] = "500311"
			)
			
			VAR Ingemar = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers] * 0.10,
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Medewerker ID] = "40831"
			)
			VAR Johan = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers] * 0.05,
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Medewerker ID] = "502029"
			)
			
			VAR total = Karina + Ingemar + Johan
			RETURN
			SWITCH(
			    TRUE(),
			    selectedschaaltype = "Andere OVK", total,
			    NOT HASONEVALUE('Dim SchaalType'[SchaalType Forecasting]), total,
			    BLANK()
			)
