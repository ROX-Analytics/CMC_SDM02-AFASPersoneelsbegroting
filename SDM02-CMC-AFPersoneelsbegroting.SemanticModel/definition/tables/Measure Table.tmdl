	measure 'LC 3086 - Feesturen SD' =
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			RETURN
			IF(
			    NOT ISBLANK([(M) LC 2434 - Salaris]),
			    CALCULATE(
			        STDEV.S('Fact Personeels Kosten'[LC - 3086 Feesturen]),
			        FILTER(
			            ALL('Dim Period'),
			            'Dim Period'[Year] >= minyear
			            && 'Dim Period'[Year] <= currentyear - 1
			        ),
			        'Fact Forecasting Medewerkers'[LC] = "3086"
			    ),
			    BLANK()
			)
		displayFolder: Statistics\Standarddeviation
		lineageTag: 258d6ee8-7741-41fa-aedc-4d12cdd3ba6d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

