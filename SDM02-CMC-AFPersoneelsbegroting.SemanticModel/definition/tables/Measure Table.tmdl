	measure 'Count Months based on selectedvalue' = ```
			
			VAR MinMonth = MIN ( 'Dim Period'[Month no.] )
			VAR MaxMonth = MAX ( 'Dim Period'[Month no.] )
			VAR SelYear  = SELECTEDVALUE ( 'Dim Period'[Year] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Dim Period'[Month no.] ),
			    KEEPFILTERS (
			        FILTER (
			            ALL ( 'Dim Period'[Month no.] ),
			            'Dim Period'[Month no.] >= MinMonth &&
			            'Dim Period'[Month no.] <= MaxMonth
			        )
			    ),
			    KEEPFILTERS ( 'Dim Period'[Year] = SelYear )
			)
			
			```
		formatString: 0
		displayFolder: Forecasting
		lineageTag: e2f4e740-c2d1-4599-a3bd-deabd3413746

	measure '(V) Belastbare Loon' = ```
			
