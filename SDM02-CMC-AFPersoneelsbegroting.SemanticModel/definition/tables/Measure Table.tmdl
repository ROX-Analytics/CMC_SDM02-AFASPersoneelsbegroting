	measure '(M) GB 4121500 - Kosten Stagaires' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR glisinscope = ISINSCOPE('Dim Grootboek'[Code Grootboek])
			VAR LCisinscope = ISINSCOPE('Dim Looncomponent'[LC])
			VAR selectedschaaltype = SELECTEDVALUE('Dim SchaalType'[SchaalType Forecasting])
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag Stagaire] = 1
			)
			
			VAR kosten = 
			CALCULATE(
			    SUM('Dim Kosten Stagaires'[Kosten]) * 12,
			    'Dim Medewerker'[Flag Stagaire] = 1
			)
			
			VAR totalekosten = 
			SUMX(
			    basesetmedewerker,
			    kosten
			)
			
			VAR result =
			IF(
			    glisinscope || LCisinscope,
			SWITCH(
			    TRUE(),
			    selectedGL = "4121500" && selectedLC = "0001", totalekosten,
			    selectedGL = "4121500" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten,
			    selectedLC = "0001" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), totalekosten,
			    BLANK()
			),
			BLANK()
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedschaaltype = "Andere OVK", result,
			    NOT HASONEVALUE('Dim SchaalType'[SchaalType Forecasting]), result,
			    BLANK()
			)
			
			```
		displayFolder: Forecasting\Medewerker
		lineageTag: 67beec54-532b-4293-9365-a0612e129629

