			   (DIVIDE(14000, 12) * [FTE Forecasting Vacatures]),
			    'Dim SchaalType'[SchaalType Forecasting] IN {"LNT", "Andere OVK"},
			    'Dim Type Personeel'[Type Zorg Functie] = " Medisch Specialisten"
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4120000" && selectedLC = "3080", BaseSalariesLC,
			    selectedGL = "4120000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), BaseSalariesLC,
