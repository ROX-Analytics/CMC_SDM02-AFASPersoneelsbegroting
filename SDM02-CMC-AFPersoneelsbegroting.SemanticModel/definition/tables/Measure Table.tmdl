	measure '(M) GB 4118000 - Medische Uitzendkosten' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR selectedkosten = SELECTEDVALUE('Series GB 4118000 - Medisch Uitzendkosten'[Waarde])
			VAR countmedewerkers = 
			CALCULATE(
			    DISTINCTCOUNT('Fact Forecasting MdW LC Overig per GB'[Medewerker ID]),
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    ALL('Dim Medewerker')
			)
			
			VAR kostenmdw = SUMX(
			    VALUES('Fact Forecasting MdW LC Overig per GB'[Medewerker ID]),
			        DIVIDE(selectedkosten, countmedewerkers, 0)
			)
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4118000" && selectedLC = "0001", kostenmdw,
			    selectedGL = "4118000" && ISINSCOPE('Dim Looncomponent'[LC]), kostenmdw,
			    BLANK()
			)
