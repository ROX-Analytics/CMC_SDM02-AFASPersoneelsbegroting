	measure '(M) LC 2807 - WG bijdrage premie AOV/AWW' = ```
			
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR SelectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR glisinscope = ISINSCOPE('Dim Grootboek'[Code Grootboek])
			VAR LCisinscope = ISINSCOPE('Dim Looncomponent'[LC])
			
			VAR amount = 
			SUMX(
			    'Dim Medewerker',
			    CALCULATE(
			        [(M) Berekende WG AOV /AWW],
			        ALL('Dim Grootboek'),
			        ALL('Dim Looncomponent')
			    )
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedLC = "2807" && SelectedGL = "4110000", amount,
			    selectedLC = "2807" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), amount,
			    SelectedGL = "4110000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), amount,
			    BLANK()
			)
