	measure 'Selected filters' = ```
			
			VAR MaxFilters = 25
			
			VAR selfilters =
			IF ( 
			    ISFILTERED ( 'Dim Calendar'[Year] ), 
			    VAR ___f = FILTERS ( 'Dim Calendar'[Year] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Calendar'[Year] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Calendar'[Year], ", " )
			    VAR ___x = "Year: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim calendar'[Year (wk)] ), 
			    VAR ___f = FILTERS ( 'Dim Calendar'[Year (wk)] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Calendar'[Year (wk)] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Calendar'[Year (wk)], ", " )
			    VAR ___x = "Year: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Calendar'[Month name (short)] ), 
			    VAR ___f = FILTERS ( 'Dim Calendar'[Month name (short)] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Calendar'[Month name (short)] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Calendar'[Month name (short)], ", " )
			    VAR ___x = "Month: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim calendar'[Month no.] ), 
			    VAR ___f = FILTERS ( 'Dim Calendar'[Month no.] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Calendar'[Month no.] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Calendar'[Month no.], ", " )
			    VAR ___x = "Month no: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim calendar'[Week no.] ), 
			    VAR ___f = FILTERS ( 'Dim Calendar'[Week no.] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Calendar'[Week no.] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Calendar'[Week no.], ", " )
			    VAR ___x = "Week no: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Cluster/Afdeling Formatieplaats'[Cluster/Afdeling Formatieplaatsniveau]), 
			    VAR ___f = FILTERS ( 'Dim Cluster/Afdeling Formatieplaats'[Cluster/Afdeling Formatieplaatsniveau] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Cluster/Afdeling Formatieplaats'[Cluster/Afdeling Formatieplaatsniveau] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Cluster/Afdeling Formatieplaats'[Cluster/Afdeling Formatieplaatsniveau], ", " )
			    VAR ___x = "Cluster/Afdeling Formatieplaatsniveau: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Cluster/Afdeling Functienveau'[Cluster/Afdeling Functienveau]), 
			    VAR ___f = FILTERS ( 'Dim Cluster/Afdeling Functienveau'[Cluster/Afdeling Functienveau] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Cluster/Afdeling Functienveau'[Cluster/Afdeling Functienveau] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Cluster/Afdeling Functienveau'[Cluster/Afdeling Functienveau], ", " )
			    VAR ___x = "Cluster/Afdeling Functieniveau: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Dienstbetrekking'[Dienstbetrekking]), 
			    VAR ___f = FILTERS ( 'Dim Dienstbetrekking'[Dienstbetrekking] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Dienstbetrekking'[Dienstbetrekking] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Dienstbetrekking'[Dienstbetrekking], ", " )
			    VAR ___x = "Dienstbetrekking: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Formatieplaats'[Formatieplaats + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Formatieplaats'[Formatieplaats + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Formatieplaats'[Formatieplaats + Omschrijving])
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Formatieplaats'[Formatieplaats + Omschrijving], ", " )
			    VAR ___x = "Formatieplaats: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Functie'[Functiecode + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Functie'[Functiecode + Omschrijving]) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Functie'[Functiecode + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Functie'[Functiecode + Omschrijving], ", " )
			    VAR ___x = "Functie: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Grootboek'[Code GB + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Grootboek'[Code GB + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Grootboek'[Code GB + Omschrijving])
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Grootboek'[Code GB + Omschrijving], ", " )
			    VAR ___x = "Grootboek: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Indexering'[Indexering]), 
			    VAR ___f = FILTERS ( 'Dim Indexering'[Indexering] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Indexering'[Indexering] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Indexering'[Indexering], ", " )
			    VAR ___x = "indexering: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving], ", " )
			    VAR ___x = "Kostenplaats: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Looncomponent'[LC Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Looncomponent'[LC Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Looncomponent'[LC Code + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Looncomponent'[LC Code + Omschrijving], ", " )
			    VAR ___x = "Looncomponent: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Medewerker Details'[Mdw ID + Voornaam]), 
			    VAR ___f = FILTERS ( 'Dim Medewerker Details'[Mdw ID + Voornaam] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Medewerker Details'[Mdw ID + Voornaam] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Medewerker Details'[Mdw ID + Voornaam], ", " )
			    VAR ___x = "Medewerker: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Organisatie Eenheid'[OE Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Organisatie Eenheid'[OE Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Organisatie Eenheid'[OE Code + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Organisatie Eenheid'[OE Code + Omschrijving], ", " )
			    VAR ___x = "Organisatie Eenheid: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Organisatie Eenheid'[OE Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Organisatie Eenheid'[OE Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Organisatie Eenheid'[OE Code + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Organisatie Eenheid'[OE Code + Omschrijving], ", " )
			    VAR ___x = "Organisatie Eenheid: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Period'[Month name (short)]), 
			    VAR ___f = FILTERS ( 'Dim Period'[Month name (short)] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Period'[Month name (short)] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Period'[Month name (short)], ", " )
