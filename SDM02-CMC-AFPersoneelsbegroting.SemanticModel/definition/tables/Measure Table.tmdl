	measure '(A) LC 3086 Feesturen Actuals' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			VAR feesturenbase = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    'Dim Looncomponent'[LC] = "3086",
			    ALL('Dim Looncomponent'),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			
			RETURN
			CALCULATE(
			    DIVIDE(feesturenbase ,yearforaverage, 0),
			    ALL('Dim Period'),
			    ALL('Dim Looncomponent')
			)
			```
