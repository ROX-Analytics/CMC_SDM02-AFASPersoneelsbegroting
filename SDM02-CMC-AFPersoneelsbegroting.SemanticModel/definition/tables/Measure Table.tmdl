			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Looncomponent'[LC Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Looncomponent'[LC Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
