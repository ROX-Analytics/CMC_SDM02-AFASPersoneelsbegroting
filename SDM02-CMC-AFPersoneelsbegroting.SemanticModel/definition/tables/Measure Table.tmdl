	measure 'Begroot (FTE)' = SUM('Fact FormatiePlaats'[FTE_Begroot])
		formatString: #,0.00
		displayFolder: Formatie Plaats
		lineageTag: d9fa012b-2b8b-4c11-8bf3-0f8275666e7b

	measure 'Actuals (FTE)' = ```
			
			VAR selectedperiod = SELECTEDVALUE('Dim Period'[Month no.])
			VAR selectedyear = SELECTEDVALUE('Dim Period'[Year])
			
			VAR maxperiod = 
			CALCULATE(
			    MAX('Fact Actuals FTE'[Boeking Year/Period]),
			    'Dim Period'[Year] = selectedyear
			)
			RETURN
			IF(
			    selectedperiod,
			    CALCULATE(
			        SUM('Fact Actuals FTE'[FTE]),
			        'Dim Period'[Month no.] = selectedperiod
			    ),
			    CALCULATE(
			        SUM('Fact Actuals FTE'[FTE]),
			        'Dim Period'[Year/Period] = maxperiod
			    )
			)
			```
		formatString: #,0.00
		displayFolder: Personeel
		lineageTag: 9dfdd747-b722-4dab-aa0a-f7bef93f6627

	measure 'Verschil (FTE)' = SUM('Fact FormatiePlaats'[Verschil (excl)])
		formatString: #,0.00
		displayFolder: Formatie Plaats
		lineageTag: 9cdd3a6a-3537-4663-97b4-df1417b6b9f4

	measure 'Mederwerkers (FTE)' =
			
			VAR StartDate = MIN('Dim Calendar'[Date])
			VAR EndDate = MAX('Dim Calendar'[Date])
			RETURN
			CALCULATE(
			    SUMX(
			        'Dim Medewerker',
			        IF(
			            'Dim Medewerker'[Datum_in_dienst] <= EndDate &&
			            (ISBLANK('Dim Medewerker'[Datum_uit_dienst]) || 'Dim Medewerker'[Datum_uit_dienst] >= StartDate),
			            'Dim Medewerker'[Aantal_FTE],
			            0
			        )
			    ),
			    FILTER(
			        'Dim Calendar',
			        'Dim Calendar'[Date] >= StartDate && 'Dim Calendar'[Date] <= EndDate
			    )
			)
		formatString: #,0.00
		displayFolder: Formatie Plaats
		lineageTag: 438b1594-9f32-427f-8a33-3265b0f54b35

	measure 'Medewerkers 2 (FTE)' = ```
			
			CALCULATE(
			    AVERAGEX(
			        VALUES('Dim calendar'[Year/Month no.]), 
			        [Mederwerkers (FTE)]
			    ),
			    DATESBETWEEN('Dim Calendar'[Date], MIN('Dim Calendar'[Date]), MAX('Dim Calendar'[Date]))
			)
			```
		formatString: #,0.00
		displayFolder: Formatie Plaats
		lineageTag: e3ae9388-6ae7-45ee-87cf-988a9ad8b48c

	measure SelectedDaysCount = ```
			
			VAR selectedyear = SELECTEDVALUE('Dim Period'[Year])
			VAR selectedmonth = SELECTEDVALUE('Dim Period'[Month name (short)])
			RETURN
			    CALCULATE(
			        COUNTROWS(
			            VALUES('Dim Calendar'[Date])
			        ),
			        ALL('Dim Period'[Year/Period]),
			        ALL('Dim Period'[Month name (short)]),
			        ALL('Dim Period'[Month no.]),
			        'Dim Calendar'[Year] = selectedyear
			    )
			
			```
		formatString: 0
		displayFolder: Formatie Plaats
		lineageTag: c51e88a9-2636-4229-802b-3fce27e40ac0

	measure 'Begroot (FTE) Total' = ```
			
			    CALCULATE(
			        DIVIDE([Begroot (FTE)], [SelectedDaysCount]),
			        ALL('Dim Period'[Month name (short)]),
			        ALL('Dim Period'[Year/Period])
			    )
			
			```
		formatString: #,0.00
		displayFolder: Formatie Plaats
		lineageTag: 25b9d069-154d-4515-abd4-559425062078

	measure 'Formatie Verschil' =
			
