	measure '(M) LC 3014 - Frequentietoeslag' = ```
			
			VAR salaris = 
			CALCULATE(
			    [Salaris Bedrag Forecasting Medewerkers],
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1,
			    'Dim Looncomponent'[LC] = "3014",
			    'Dim Medewerker'[Flag Medische Specialisten] = 1
			)
			VAR standbyperc = [% LC 3014 - Frequentietoeslag]
			
			RETURN
