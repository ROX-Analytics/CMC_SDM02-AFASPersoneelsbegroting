	measure '(M) LC 3086 - Feesturen' = ```
			
			// 4101500
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			VAR total = [(WA) GB 4101500 - Feesturen/dagen]
			
			VAR countmedewerkers = 
			CALCULATE(
			    [Count Medewerkers],
			    ALL('Dim Medewerker'),
			    'Dim Medewerker'[Feesturen flag] = 1,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Feesturen flag] = 1 && 
			    'Dim Medewerker'[Status_dienstverband] = "In dienst"
			)
			
			VAR kosten = 
			CALCULATE(
			    DIVIDE(total, countmedewerkers, BLANK())
			)
			
			VAR totalekosten = 
			SUMX(
			    basesetmedewerker,
			    kosten
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4101500" && selectedLC = "3086", totalekosten,
			    selectedGL = "4101500" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten,
			    BLANK()
			)
			
			```
