	measure 'Test (Total Dienstjaren Jubileum)' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR selectedDienstJaren = SELECTEDVALUE('Dim Gratificatie Jubileum'[Dienstjubileum])
			VAR selectedJub = SELECTEDVALUE('Dim Gratificatie Jubileum'[Percentage v. Basissalaris])
			VAR anniver = MAX('Fact Forecasting Medewerkers'[Anniversary Month])
			// VAR BaseSalaryGL = 
			// CALCULATE(
			//     [Bedrag Forecasting Medewerkers],
			//     TREATAS({"4100000"}, 'Fact Forecasting Medewerkers'[Grootboekrekening]), 
			//     'Dim Medewerker'[Dienstjaren] IN {12.5, 25, 35, 40},
			//     'Dim Period'[Month no.] = anniver
			// )
			
			VAR BaseSalaryLC = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Dienstjaren] IN {12.5, 25, 35, 40},
			    'Dim Period'[Month no.] = anniver
			)
			 
			VAR GLandLC =
			SWITCH(
			    TRUE(),
			    selectedGL = "4105000" && selectedLC = "2486", BaseSalaryLC,
			    selectedGL = "4105000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), BaseSalaryLC,
			    BLANK()
			)
			
			VAR TotalAllDienstjaren =
			CALCULATE(
			    CALCULATE(
			        DIVIDE(GLandLC, 12, BLANK()),
			        'Dim Medewerker'[Dienstjaren] = 12.5
			    ) +
			    CALCULATE(
			        2   * DIVIDE(GLandLC, 12, BLANK()),
			        'Dim Medewerker'[Dienstjaren] = 25
			    ) +
			    CALCULATE(
			        2.5 * DIVIDE(GLandLC, 12, BLANK()),
			        'Dim Medewerker'[Dienstjaren] = 35
			    ) +
			    CALCULATE(
			        3   * DIVIDE(GLandLC, 12, BLANK()),
			        'Dim Medewerker'[Dienstjaren] = 40
			    )
			)
			
			RETURN
			TotalAllDienstjaren
			```
