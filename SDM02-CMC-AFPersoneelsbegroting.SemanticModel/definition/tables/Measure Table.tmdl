			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Grootboek'[Code GB + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Grootboek'[Code GB + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Grootboek'[Code GB + Omschrijving])
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Grootboek'[Code GB + Omschrijving], ", " )
			    VAR ___x = "Grootboek: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Indexering'[Indexering]), 
			    VAR ___f = FILTERS ( 'Dim Indexering'[Indexering] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Indexering'[Indexering] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Indexering'[Indexering], ", " )
			    VAR ___x = "indexering: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Kostenplaats'[Kostenplaats Code + Omschrijving], ", " )
			    VAR ___x = "Kostenplaats: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Looncomponent'[LC Code + Omschrijving]), 
			    VAR ___f = FILTERS ( 'Dim Looncomponent'[LC Code + Omschrijving] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
