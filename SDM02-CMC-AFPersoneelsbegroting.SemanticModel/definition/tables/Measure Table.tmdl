	measure '(M) LC 3019 - Standbytoelage FTE' = ```
			
			VAR selectedPeriod = SELECTEDVALUE('Dim Period'[Month no.])
			VAR selectedYear = SELECTEDVALUE('Dim Period'[Year])
			VAR maxPeriod =
			    CALCULATE(
			        MAX('Dim Period'[Month no.]),
			        REMOVEFILTERS('Dim Period')        // removes month-level filters for correct total
			    )
			VAR maxFTE =
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[FTE (Divided by 100)]),
			        'Dim Looncomponent'[LC] = "3019",
			        'Dim Period'[Month no.] = maxPeriod
			    )
			
			RETURN
			IF(
			    ISINSCOPE('Dim Period'[Month no.]),
			    CALCULATE(
			        SUM('Fact Forecasting Medewerkers'[FTE (Divided by 100)]),
			        'Dim Looncomponent'[LC] = "3019"
			    ),
			    maxFTE
			)
			
			```
		formatString: 0.00
		displayFolder: Forecasting\Medewerker\Support
		lineageTag: 6799745e-4c8a-4d2a-936e-e62a309e6730

