	measure '(T) Maanden in Dienst' = ```
			
			VAR maxmonths = MAX('Dim Period'[Month no.])
			VAR minmonths = MIN('Dim Period'[Month no.])
			VAR selectedyear = SELECTEDVALUE('Dim Period'[Year])
			VAR Baseset = 
			SUMMARIZE(
			    FILTER(
			        'Fact Salaris Indexering Actuals',
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] <= maxmonths ||
			        'Fact Salaris Indexering Actuals'[Boekingsperiode] >= minmonths
			    ),
			    'Fact Salaris Indexering Actuals'[Medewerker ID],
			    'Fact Salaris Indexering Actuals'[Boekingsperiode]
			)
			
			RETURN
			CALCULATE(
			    COUNTROWS(Baseset),
			    ALL('Dim Period')
			)
