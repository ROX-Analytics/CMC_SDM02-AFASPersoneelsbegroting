	measure '(M) GB 4105000 - Gratificaties' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR selectedDienstJaren = SELECTEDVALUE('Dim Gratificatie Jubileum'[Dienstjubileum])
			VAR selectedJub = SELECTEDVALUE('Dim Gratificatie Jubileum'[Percentage v. Basissalaris])
			VAR anniver = MAX('Fact Forecasting Medewerkers'[Anniversary Month])
			// VAR BaseSalaryGL = 
			// CALCULATE(
			//     [Bedrag Forecasting Medewerkers],
			//     TREATAS({"4100000"}, 'Fact Forecasting Medewerkers'[Grootboekrekening]), 
			//     'Dim Medewerker'[Dienstjaren] IN {12.5, 25, 35, 40},
			//     'Dim Period'[Month no.] = anniver
			// )
			VAR basesetmedewerker = 
			CALCULATETABLE(
			    VALUES('Dim Medewerker'[Medewerker ID]),
			    'Dim Medewerker'[Status_dienstverband] = "In dienst" && 
			    'Dim Medewerker'[Flag 4105000 - Gratificaties] = 1 && 
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 
			)
			VAR BaseSalaryLC12 = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Dienstjaren Forecasting] = 12.5,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    'Dim Medewerker'[Flag 4105000 - Gratificaties] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 
			)
			VAR BaseSalaryLC25 = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Dienstjaren Forecasting] = 25,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    'Dim Medewerker'[Flag 4105000 - Gratificaties] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 
			)
			
			VAR BaseSalaryLC35 = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Dienstjaren Forecasting] = 35,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    'Dim Medewerker'[Flag 4105000 - Gratificaties] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 
			)
			VAR BaseSalaryLC45 = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    'Dim Medewerker'[Dienstjaren Forecasting] = 45,
			    'Dim Medewerker'[Status_dienstverband] = "In dienst",
			    'Dim Medewerker'[Flag 4105000 - Gratificaties] = 1,
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1 
			)
			    VAR dienst12 = CALCULATE(DIVIDE(BaseSalaryLC12, 12, BLANK()))
			    VAR dienst25 = CALCULATE(2 * DIVIDE(BaseSalaryLC25, 12, BLANK()))
			    VAR dienst35 = CALCULATE(2.5 * DIVIDE(BaseSalaryLC35, 12, BLANK()))
			    VAR dienst40 = CALCULATE(3 * DIVIDE(BaseSalaryLC45, 12, BLANK()))
			
			VAR totalekosten = dienst12 + dienst25 + dienst35 + dienst40
			
			
			VAR GLandLC =
			SWITCH(
			    TRUE(),
			    selectedGL = "4105000" && selectedLC = "2486", totalekosten,
			    selectedGL = "4105000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten,
			    BLANK()
			)
			RETURN
			GLandLC
			```
