	measure '% WG Pensioen Toeslag' = ```
			
			VAR brutosalaris = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    'Dim Grootboek'[Code Grootboek] = "4100000"
			)
			
			VAR WGpensioen = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    'Dim Grootboek'[Code Grootboek] = "4115000"
			)
			
			RETURN
			DIVIDE(WGpensioen, brutosalaris)
