	measure '(A) LC 3010 Schemawerk 30%' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 4
			
			VAR BaseYearSet = 
			FILTER(
			    ALL('Dim Period'),
			    'Dim Period'[Year] >= minyear
			    && 'Dim Period'[Year] <= currentyear - 1
			)
			
			
			VAR yearforaverage = 
			CALCULATE(
			    DISTINCTCOUNT('Dim Period'[Year]),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			VAR schemawerk = 
			CALCULATE(
			    [Bedrag Personeelskosten],
			    'Dim Looncomponent'[LC] = "3010",
			    ALL('Dim Looncomponent'),
			    ALL('Dim Grootboek'),
			    FILTER(
			        ALL('Dim Period'),
			        'Dim Period'[Year] >= minyear
			        && 'Dim Period'[Year] <= currentyear - 1
			    )
			)
			
			
			RETURN
			CALCULATE(
			    DIVIDE(schemawerk ,yearforaverage, 0),
			    ALL('Dim Period'),
			    ALL('Dim Grootboek'),
			    ALL('Dim Looncomponent')
			)
			```
		formatString: 0.00
		displayFolder: Statistics\Averages
		lineageTag: d6b21947-f185-46e1-837d-38cd7a655758

