	measure '(M) GB 4125100 - Personeel niet in Loondienst' = ```
			
			VAR personeelnietinloondienst = 
			CALCULATE(
			    DIVIDE([(A) GB 4125100 - Personeel niet in Loondienst], CALCULATE([Count Medewerkers], ALL('Dim Medewerker')), BLANK()),
			    'Dim Grootboek'[Code Grootboek] = "4125100"
			)
			
			VAR selectedkoers = SELECTEDVALUE('Dagkoers EURO/USD'[Dagkoers])
			
			VAR erasmuskosten = 
			CALCULATE(
			    DIVIDE(SUM('Dagkoers EURO/USD'[Bedrag Erasmus in XCG]), CALCULATE([Count Medewerkers], ALL('Dim Medewerker')), BLANK()),
			    'Dagkoers EURO/USD'[Dagkoers] = selectedkoers,
			    'Dim Grootboek'[Code Grootboek] = "4125100"
			)
			
			
			RETURN
			SUMX(
			    'Dim Medewerker',
			    CALCULATE(
			        personeelnietinloondienst + erasmuskosten,
			        'Dim Grootboek'[Code Grootboek] = "4125100",
			        ALL('Dim Grootboek')
			    )
			)
			
			
			```
