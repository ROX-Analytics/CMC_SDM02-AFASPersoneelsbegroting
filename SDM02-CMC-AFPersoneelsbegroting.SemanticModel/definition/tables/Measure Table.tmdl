	measure '(M) LC 3014 - Frequentietoeslag' = ```
			
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			
			VAR basesetmedewerker = 
			FILTER(
			    'Dim Medewerker',
			    'Dim Medewerker'[Flag Medische Specialisten] = 1 &&
			    'Dim Medewerker'[Medewerkers in Fact Forecasting] = 1
			)
			
			VAR BaseSalaryLC = 
			CALCULATE(
			    [Bedrag Forecasting Medewerkers],
			    TREATAS({"2434"}, 'Fact Forecasting Medewerkers'[LC]),
			    basesetmedewerker
			)
			
			VAR intenstieit = 
			CALCULATE(
			    'Measure Table'[% LC 3014 - Frequentietoeslag],
			    basesetmedewerker
			)
			
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4103000" && selectedLC = "3014", BaseSalaryLC * intenstieit,
			    selectedLC = "3014" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), BaseSalaryLC * intenstieit,
			    selectedGL = "4103000" && NOT HASONEVALUE('Dim Looncomponent'[LC]), BaseSalaryLC * intenstieit,
			    BLANK()
			    )
			```
