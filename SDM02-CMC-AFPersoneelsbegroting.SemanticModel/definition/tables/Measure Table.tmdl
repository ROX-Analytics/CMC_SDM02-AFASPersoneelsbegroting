	measure '(V) LC 3086 - Feesturen' = ```
			
			VAR selectedLC = SELECTEDVALUE('Dim Looncomponent'[LC])
			VAR selectedGL = SELECTEDVALUE('Dim Grootboek'[Code Grootboek])
			
			VAR basesetvacatures = 
			FILTER(
			    'Dim Vacatures Medewerker',
			    'Dim Vacatures Medewerker'[Feesturen flag] = 1
			)
			VAR totalekosten =
			CALCULATE(
			    [Bedrag Forecasting Vacatures],
			    basesetvacatures
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    selectedGL = "4101500" && selectedLC = "3086", totalekosten * 0.037,
			    selectedGL = "4101500" && NOT HASONEVALUE('Dim Looncomponent'[LC]), totalekosten * 0.037,
			    selectedLC = "3086" && NOT HASONEVALUE('Dim Grootboek'[Code Grootboek]), totalekosten * 0.037,
			    BLANK()
			)
			
			
			```
