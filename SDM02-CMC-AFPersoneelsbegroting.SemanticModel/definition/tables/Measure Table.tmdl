	measure '(WA) GB 4101100 - Maaltijd Vergoeding' = ```
			
			VAR currentyear = YEAR(TODAY())
			VAR minyear = currentyear - 2
			
			RETURN
			CALCULATE(
			    DIVIDE([Sum (u * w)], [(W) Sum of Weights]),
			    ALL('Dim Grootboek'),
			    'Dim Grootboek'[Code Grootboek] = "4101100",
			    FILTER(
			        'Fact GL Totals Per Year/Period',
			        'Fact GL Totals Per Year/Period'[Jaar] >= minyear && 
			        'Fact GL Totals Per Year/Period'[Jaar] <= currentyear - 1
			    )
			)
