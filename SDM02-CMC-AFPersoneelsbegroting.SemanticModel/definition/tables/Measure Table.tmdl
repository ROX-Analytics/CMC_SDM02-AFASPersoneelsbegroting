			    'Measure Table'[(V) LC 3121 - Reservering Vakantiegeld] +
			    'Measure Table'[(V) LC 3086 - Feesturen] + 
			    'Measure Table'[(V) LC 3014 - Frequentietoeslag] + 
			    'Measure Table'[(V) LC 3015 - Intensiteitstoeslag] +
			    'Measure Table'[(V) LC 2622 - Overwerk 200%] +
			    'Measure Table'[(V) LC 3075 - Overwerk 300%]
