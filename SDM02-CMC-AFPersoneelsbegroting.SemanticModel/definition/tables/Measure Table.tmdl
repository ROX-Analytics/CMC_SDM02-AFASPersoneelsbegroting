			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim Personeel Type'[Type Personeel]), 
			    VAR ___f = FILTERS ( 'Dim Personeel Type'[Type Personeel] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim Personeel Type'[Type Personeel] )
			    VAR ___d = CONCATENATEX ( ___t, 'Dim Personeel Type'[Type Personeel], ", " )
			    VAR ___x = "Type Personeel: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			&
			IF ( 
			    ISFILTERED ( 'Dim SchaalType'[SchaalType]), 
			    VAR ___f = FILTERS ( 'Dim SchaalType'[SchaalType] ) 
			    VAR ___r = COUNTROWS ( ___f ) 
			    VAR ___t = TOPN ( MaxFilters, ___f, 'Dim SchaalType'[SchaalType])
			    VAR ___d = CONCATENATEX ( ___t, 'Dim SchaalType'[SchaalType], ", " )
			    VAR ___x = "Type Schaal: " & ___d & IF(___r > MaxFilters, ", ... [" & ___r & " items selected]") & " " 
			    RETURN REPLACE(___x, LEN(___x),1," | ")
			)
			RETURN
			IF(
			    LEN(selfilters)>0,
			    REPLACE(selfilters, LEN(selfilters)-2,3,""),
			    ""
			)
			```
